https://parcel-price-comparison.pages.dev/*
  X-Robots-Tag: noindex

# Security & Caching Headers for CourierPrice

# Default headers applied to all routes
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block

# Immutable asset caching for Vite / Astro bundled assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache-control for static fonts and icons
/assets/*
  Cache-Control: public, max-age=2592000

# HTML documents should always be fresh / revalidated
/*.html
  Cache-Control: public, max-age=0, must-revalidate