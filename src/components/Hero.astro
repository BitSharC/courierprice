---
// Hero section with Vercel aesthetic, period-terminated sentence-case header, and animated mesh gradient.
---

<section class="relative overflow-hidden bg-canvas py-24 sm:py-32 lg:py-40 border-b border-hairline transition-colors duration-200">
  <!-- Mesh Gradient Backgrounds -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden select-none">
    <!-- Light Mode Gradient Glow -->
    <div class="absolute -top-[30%] left-[5%] right-[5%] h-[80%] rounded-[100%] opacity-70 dark:hidden">
      <div class="absolute inset-0 mesh-glow-1 bg-gradient-to-r from-gradient-develop-start via-cyan to-gradient-preview-start opacity-40"></div>
      <div class="absolute inset-0 mesh-glow-2 bg-gradient-to-r from-gradient-preview-end via-gradient-ship-start to-gradient-ship-end opacity-30 translate-x-[15%] translate-y-[10%]"></div>
    </div>
    <!-- Dark Mode Gradient Glow (More subtle and deep colors) -->
    <div class="absolute -top-[40%] left-[10%] right-[10%] h-[90%] rounded-[100%] hidden dark:block">
      <div class="absolute inset-0 mesh-glow-1 bg-gradient-to-r from-gradient-develop-start via-violet to-gradient-preview-start opacity-35"></div>
      <div class="absolute inset-0 mesh-glow-2 bg-gradient-to-r from-gradient-preview-end via-gradient-ship-start to-gradient-ship-end opacity-20 translate-x-[10%] translate-y-[5%]"></div>
    </div>
  </div>

  <!-- Decorative technical grid lines -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(128,128,128,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(128,128,128,0.03)_1px,transparent_1px)] bg-[size:4rem_4rem] dark:bg-[linear-gradient(to_right,rgba(255,255,255,0.015)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.015)_1px,transparent_1px)]"></div>

  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
    <!-- Monospace Technical Eyebrow Banner -->
    <div class="inline-flex items-center gap-2 mb-6 px-3 py-1 rounded-full border border-hairline bg-canvas-soft-2 shadow-level-1 transition-colors duration-200">
      <span class="inline-block h-2 w-2 rounded-full bg-success animate-pulse"></span>
      <span class="caption-mono uppercase tracking-wider text-body" data-i18n="hero-badge">
        Comparing Major Global Courier Services
      </span>
    </div>

    <!-- Main Headline: Display XL, sentence case, period terminated, negative tracking -->
    <h1 class="display-xl text-ink tracking-tighter mb-6 mx-auto max-w-4xl text-balance" data-i18n="hero-title">
      Compare courier prices globally in seconds.
    </h1>

    <!-- Subtitle: Body LG, secondary color -->
    <p class="body-lg text-body mb-10 mx-auto max-w-2xl text-balance" data-i18n="hero-subtitle">
      Eliminate the hassle of visiting multiple shipping websites individually. Estimate shipping charges, compare delivery speeds, and find the cheapest courier service in under 30 seconds.
    </p>

    <!-- CTAs: Button-primary and Button-secondary -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#calculator" class="button-primary w-full sm:w-auto shadow-level-4 font-sans flex items-center justify-center gap-1">
        <span data-i18n="hero-cta-compare">Calculate & Compare Shipping Cost</span>
        <svg class="ml-2 h-4 w-4 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19 12 12 19 5 12"></polyline>
        </svg>
      </a>
      <a href="#guides" data-i18n="hero-cta-learn" class="button-secondary w-full sm:w-auto">
        Learn How Pricing Works
      </a>
    </div>

    <!-- Trust banner (mini logo strip) -->
    <div class="mt-20 border-t border-hairline pt-8 transition-colors duration-200">
      <p class="caption-mono uppercase tracking-wider text-mute mb-6" data-i18n="hero-providers-title">
        COMPATIBLE PROVIDERS
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 opacity-60 dark:opacity-40">
        <span class="font-sans font-semibold text-body text-sm uppercase tracking-widest hover:text-ink transition-colors cursor-default">India Post</span>
        <span class="font-sans font-semibold text-body text-sm uppercase tracking-widest hover:text-ink transition-colors cursor-default">Blue Dart</span>
        <span class="font-sans font-semibold text-body text-sm uppercase tracking-widest hover:text-ink transition-colors cursor-default">DTDC</span>
        <span class="font-sans font-semibold text-body text-sm uppercase tracking-widest hover:text-ink transition-colors cursor-default">Delhivery</span>
        <span class="font-sans font-semibold text-body text-sm uppercase tracking-widest hover:text-ink transition-colors cursor-default">Garudavega</span>
        <span class="font-sans font-semibold text-body text-sm uppercase tracking-widest hover:text-ink transition-colors cursor-default">XpressBees</span>
        <span class="font-sans font-semibold text-body text-sm uppercase tracking-widest hover:text-ink transition-colors cursor-default">Porter</span>
      </div>
    </div>
  </div>
</section>
