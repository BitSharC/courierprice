---
// src/components/CalculatorForm.astro
import { COUNTRIES_DATA } from '../utils/countryData';
import { CATEGORIES } from '../utils/calculator';

interface Props {
  courierId?: string;
}

const { courierId = "" } = Astro.props;

// Determine title, subtitle, and submit button labels
let titleKey = 'form-title';
let titleText = 'Shipping details.';
let subtitleKey = 'form-subtitle';
let subtitleText = 'Configure your domestic or international shipment parameters.';
let submitBtnKey = 'form-btn-submit';
let submitBtnText = 'Compare prices';

if (courierId === 'delhivery-domestic-in') {
  titleKey = 'form-title-delhivery';
  titleText = 'Delhivery Courier Price Calculator';
  subtitleKey = 'form-subtitle-delhivery';
  subtitleText = 'Estimate domestic surface and express shipping charges for Delhivery.';
  submitBtnKey = 'form-btn-submit-delhivery';
  submitBtnText = 'Calculate Delhivery Price';
} else if (courierId === 'professional-domestic-in') {
  titleKey = 'form-title-professional';
  titleText = 'Professional Courier Price Calculator';
  subtitleKey = 'form-subtitle-professional';
  subtitleText = 'Estimate domestic shipping charges for The Professional Couriers.';
  submitBtnKey = 'form-btn-submit-professional';
  submitBtnText = 'Calculate Professional Courier Price';
}
---

<div id="calculator" data-courier-id={courierId} class="w-full bg-canvas border border-hairline rounded-lg p-6 sm:p-8 shadow-level-3 transition-colors duration-200">
  <div class="mb-6">
    <h2 class="display-sm text-ink mb-1.5" data-i18n={titleKey}>
      {titleText}
    </h2>
    <p class="body-sm text-body" data-i18n={subtitleKey}>
      {subtitleText}
    </p>
  </div>

  <!-- Domestic vs International Switcher -->
  <div class="flex justify-center mb-8">
    <div class="flex items-center gap-1 border border-hairline rounded-full p-1 bg-canvas-soft-2 shadow-level-1 text-sm transition-colors duration-200">
      <button 
        type="button" 
        id="tab-domestic" 
        class="px-5 py-1.5 rounded-full font-medium text-xs tracking-tight transition-all cursor-pointer bg-primary text-on-primary"
        data-i18n="form-tab-domestic"
      >
        Domestic
      </button>
      <button 
        type="button" 
        id="tab-international" 
        class="px-5 py-1.5 rounded-full font-medium text-xs tracking-tight text-body hover:text-ink transition-all cursor-pointer"
        data-i18n="form-tab-international"
      >
        International
      </button>
    </div>
  </div>

  <form id="shipping-form" class="space-y-6">
    <!-- Hidden input for type -->
    <input type="hidden" id="shipping-type" name="type" value="domestic" />

    <!-- Route Parameters Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Pickup Location Column -->
      <div class="space-y-4">
        <div class="flex items-center justify-between border-b border-hairline pb-1.5">
          <h3 class="body-sm-strong text-ink font-semibold flex items-center gap-1.5" data-i18n="form-pickup-title">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
            Pickup Location
          </h3>
        </div>
        
        {courierId === 'delhivery-domestic-in' || courierId === 'professional-domestic-in' ? (
          <input type="hidden" id="pickupCountry" name="pickupCountry" value="IN" />
        ) : (
          <div id="pickup-country-container" class="flex flex-col gap-1.5 hidden animate-fade-in">
            <label for="pickupCountry" class="caption text-mute text-xs font-semibold" data-i18n="form-origin-country">Origin Country</label>
            <div class="relative">
              <select id="pickupCountry" name="pickupCountry" class="form-input w-full appearance-none pr-8 font-medium">
                {Object.values(COUNTRIES_DATA).map(c => (
                  <option value={c.code} selected={c.code === 'IN'}>{c.name}</option>
                ))}
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-mute">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
        )}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- State -->
          <div class="flex flex-col gap-1.5">
            <label for="pickupState" class="caption text-mute text-xs font-semibold" data-i18n="form-pickup-state">State / Region</label>
            <div class="relative">
              <select id="pickupState" name="pickupState" required class="form-input w-full appearance-none pr-8">
                <option value="" disabled selected data-i18n="select-state-prompt">Select state/region</option>
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-mute">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
          <!-- District -->
          <div id="pickup-district-container" class="flex flex-col gap-1.5">
            <label for="pickupDistrict" class="caption text-mute text-xs font-semibold" data-i18n="form-pickup-district">District</label>
            <div class="relative">
              <select id="pickupDistrict" name="pickupDistrict" required class="form-input w-full appearance-none pr-8" disabled>
                <option value="" disabled selected data-i18n="select-district-prompt">Select district</option>
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-mute">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Destination Location Column -->
      <div class="space-y-4">
        <div class="flex items-center justify-between border-b border-hairline pb-1.5">
          <h3 id="delivery-title" class="body-sm-strong text-ink font-semibold flex items-center gap-1.5" data-i18n="form-delivery-title-dom">
            <span class="inline-block w-2 h-2 rounded-full bg-blue-500"></span>
            Delivery Location (Domestic)
          </h3>
          <button
            type="button"
            id="swap-route-btn"
            class="inline-flex items-center gap-1.5 text-xs text-mute hover:text-ink font-medium px-2.5 py-0.5 rounded-full border border-hairline hover:border-hairline-strong bg-canvas-soft-2 hover:bg-canvas transition-all cursor-pointer group active:scale-95 shadow-level-1"
            title="Swap pickup and delivery locations"
            aria-label="Swap pickup and delivery locations"
          >
            <svg id="swap-icon" class="h-3 w-3 text-mute group-hover:text-ink transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
            <span class="text-[11px] font-mono">Swap ⇄</span>
          </button>
        </div>
        
        {courierId === 'delhivery-domestic-in' || courierId === 'professional-domestic-in' ? (
          <input type="hidden" id="deliveryCountry" name="deliveryCountry" value="IN" />
        ) : (
          <div id="delivery-country-container" class="flex flex-col gap-1.5 hidden animate-fade-in">
            <label for="deliveryCountry" class="caption text-mute text-xs font-semibold" data-i18n="form-delivery-country">Destination Country</label>
            <div class="relative">
              <select id="deliveryCountry" name="deliveryCountry" class="form-input w-full appearance-none pr-8">
                <option value="" disabled selected data-i18n="select-country-prompt">Select destination country</option>
                {Object.values(COUNTRIES_DATA).map(c => (
                  <option value={c.code}>{c.name}</option>
                ))}
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-mute">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
        )}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- State -->
          <div class="flex flex-col gap-1.5">
            <label for="deliveryState" class="caption text-mute text-xs font-semibold" data-i18n="form-delivery-state">State / Region</label>
            <div class="relative">
              <select id="deliveryState" name="deliveryState" required class="form-input w-full appearance-none pr-8">
                <option value="" disabled selected data-i18n="select-state-prompt">Select state/region</option>
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-mute">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
          <!-- District -->
          <div id="delivery-district-container" class="flex flex-col gap-1.5">
            <label for="deliveryDistrict" class="caption text-mute text-xs font-semibold" data-i18n="form-delivery-district">District</label>
            <div class="relative">
              <select id="deliveryDistrict" name="deliveryDistrict" required class="form-input w-full appearance-none pr-8" disabled>
                <option value="" disabled selected data-i18n="select-district-prompt">Select district</option>
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-mute">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Parcels Section -->
    <div class="border-t border-hairline pt-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="body-md-strong text-ink" data-i18n="form-parcels-title">Parcels to Send.</h3>
        <p class="caption text-mute" data-i18n="form-parcels-subtitle">Define weight and categories for your items</p>
      </div>

      <!-- Parcels list container -->
      <div id="parcels-container" class="space-y-4">
        <!-- Render first parcel dynamically -->
        <div class="parcel-card bg-canvas-soft-2 border border-hairline p-4 rounded-md relative space-y-4 transition-colors duration-200">
          <div class="flex items-center justify-between border-b border-hairline/60 pb-2">
            <span class="caption-mono text-xs uppercase tracking-wider text-ink font-semibold">
              <span data-i18n="form-parcel-idx">Parcel #</span><span class="parcel-idx">1</span>
            </span>
            <button 
              type="button" 
              class="remove-parcel-btn hidden text-xs text-error hover:text-error-deep cursor-pointer focus:outline-none transition-colors duration-150"
              data-i18n="form-parcel-remove"
            >
              Remove
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Parcel Weight -->
            <div class="flex flex-col gap-1.5">
              <label class="body-sm-strong text-ink text-xs font-semibold" data-i18n="form-parcel-weight">Parcel Weight</label>
              <div class="flex">
                <input 
                  type="number" 
                  name="parcelWeight" 
                  min="0.01" 
                  step="any" 
                  placeholder="e.g. 2.5" 
                  required 
                  class="form-input flex-1 rounded-r-none border-r-0"
                />
                <select 
                  name="parcelWeightUnit" 
                  class="form-input w-20 rounded-l-none border-l-1 bg-canvas-soft appearance-none pr-6 cursor-pointer"
                >
                  <option value="kg">kg</option>
                  <option value="g">g</option>
                </select>
              </div>
            </div>

            <!-- Parcel Category -->
            <div class="flex flex-col gap-1.5">
              <label class="body-sm-strong text-ink text-xs font-semibold" data-i18n="form-parcel-category">Parcel Category</label>
              <div class="relative">
                <select name="parcelCategory" required class="form-input w-full appearance-none pr-8">
                  <option value="" disabled selected data-i18n="select-category-prompt">Select category</option>
                  {CATEGORIES.map(cat => (
                    <option value={cat.id} data-i18n={`cat-${cat.id}`}>{cat.name}</option>
                  ))}
                </select>
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-mute">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </div>
          </div>


          <!-- Dimensions -->
          <div class="space-y-2">
            <span class="body-sm-strong text-ink text-xs block font-semibold" data-i18n="form-parcel-dim-title">Dimensions (Optional - For Volumetric Weight)</span>
            <div class="grid grid-cols-3 gap-3">
              <div class="flex flex-col gap-1">
                <label class="caption text-mute text-xs" data-i18n="form-parcel-dim-l">Length (cm)</label>
                <input type="number" name="parcelLength" min="1" placeholder="L" class="form-input w-full" />
              </div>
              <div class="flex flex-col gap-1">
                <label class="caption text-mute text-xs" data-i18n="form-parcel-dim-w">Width (cm)</label>
                <input type="number" name="parcelWidth" min="1" placeholder="W" class="form-input w-full" />
              </div>
              <div class="flex flex-col gap-1">
                <label class="caption text-mute text-xs" data-i18n="form-parcel-dim-h">Height (cm)</label>
                <input type="number" name="parcelHeight" min="1" placeholder="H" class="form-input w-full" />
              </div>
            </div>

            <!-- Volumetric Weight Live Preview Badge -->
            <div class="volumetric-preview-badge hidden mt-2.5 p-2.5 rounded-md border text-xs flex items-center justify-between transition-all duration-200">
              <div class="flex items-center gap-2">
                <span class="text-sm">📦</span>
                <div>
                  <span class="font-medium vol-summary text-ink">Volumetric Weight: 0 kg</span>
                  <span class="block text-[11px] text-mute vol-chargeable-note"></span>
                </div>
              </div>
              <span class="vol-badge-tag px-2 py-0.5 rounded font-mono text-[10px] font-semibold"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Add another parcel button -->
      <button 
        type="button" 
        id="add-parcel-btn" 
        class="w-full mt-3 border border-dashed border-hairline py-2 flex items-center justify-center gap-1.5 hover:bg-canvas-soft-2 text-sm text-body hover:text-ink font-medium rounded-md transition-all duration-200 cursor-pointer"
      >
        <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <span data-i18n="form-parcel-btn-add">Add another parcel</span>
      </button>
      <p class="caption text-mute mt-2 text-center" data-i18n="form-parcel-vol-desc">Volumetric weight is computed per parcel as (L × W × H) / 5000 and used if it exceeds physical weight.</p>
    </div>

    <!-- Add-on switches Accordion -->
    <div class="border-t border-hairline pt-4 transition-colors duration-200">
      <button 
        type="button" 
        id="advanced-toggle" 
        class="flex items-center gap-2 text-sm font-medium text-body hover:text-ink cursor-pointer focus:outline-none"
      >
        <svg id="advanced-arrow" class="h-4 w-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
        <span data-i18n="form-addons-toggle">Shipment add-ons (Insurance, Express, Pickup)</span>
      </button>

      <div id="advanced-section" class="hidden mt-4 space-y-6 animate-fade-in">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-2">
          <!-- Insurance Toggle -->
          <label class="flex items-start gap-3 cursor-pointer group">
            <input type="checkbox" id="insurance" name="insurance" class="sr-only peer" />
            <div class="relative w-9 h-5 bg-canvas-soft-2 peer-focus:outline-none rounded-full border border-hairline peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-body peer-checked:after:bg-on-primary after:border-none after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-primary peer-checked:border-primary transition-all"></div>
            <div class="flex flex-col">
              <span class="body-sm-strong text-ink group-hover:text-primary transition-colors" data-i18n="form-addon-insurance-title">Insurance cover</span>
              <span class="caption text-mute" data-i18n="form-addon-insurance-desc">Protect valuable cargo</span>
            </div>
          </label>

          <!-- Express Delivery Toggle -->
          <label class="flex items-start gap-3 cursor-pointer group">
            <input type="checkbox" id="express" name="express" class="sr-only peer" />
            <div class="relative w-9 h-5 bg-canvas-soft-2 peer-focus:outline-none rounded-full border border-hairline peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-body peer-checked:after:bg-on-primary after:border-none after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-primary peer-checked:border-primary transition-all"></div>
            <div class="flex flex-col">
              <span class="body-sm-strong text-ink group-hover:text-primary transition-colors" data-i18n="form-addon-express-title">Express transit</span>
              <span class="caption text-mute" data-i18n="form-addon-express-desc">Prioritize delivery speed</span>
            </div>
          </label>

          <!-- Pickup Required Toggle -->
          <label class="flex items-start gap-3 cursor-pointer group">
            <input type="checkbox" id="pickupRequired" name="pickupRequired" class="sr-only peer" />
            <div class="relative w-9 h-5 bg-canvas-soft-2 peer-focus:outline-none rounded-full border border-hairline peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-body peer-checked:after:bg-on-primary after:border-none after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-primary peer-checked:border-primary transition-all"></div>
            <div class="flex flex-col">
              <span class="body-sm-strong text-ink group-hover:text-primary transition-colors" data-i18n="form-addon-pickup-title">Home pickup</span>
              <span class="caption text-mute" data-i18n="form-addon-pickup-desc">Courier collects at door</span>
            </div>
          </label>
        </div>
      </div>
    </div>

    <button 
      type="submit" 
      class="button-primary w-full shadow-level-3 font-medium transition-all"
      data-i18n={submitBtnKey}
    >
      {submitBtnText}
    </button>
  </form>
</div>

<script>
  import { COUNTRIES_DATA } from '../utils/countryData';
  import { CATEGORIES } from '../utils/calculator';
  import { TRANSLATIONS } from '../utils/translations';

  const calculatorContainer = document.getElementById('calculator');
  const courierId = calculatorContainer?.getAttribute('data-courier-id') || '';

  // Toggle Domestic/International Tab Switch
  const tabDomestic = document.getElementById('tab-domestic');
  const tabInternational = document.getElementById('tab-international');
  const shippingType = document.getElementById('shipping-type') as HTMLInputElement | null;
  
  const pickupCountryContainer = document.getElementById('pickup-country-container');
  const pickupCountrySelect = document.getElementById('pickupCountry') as HTMLSelectElement | HTMLInputElement | null;
  const pickupStateSelect = document.getElementById('pickupState') as HTMLSelectElement | null;
  const pickupDistrictSelect = document.getElementById('pickupDistrict') as HTMLSelectElement | null;
  const pickupDistrictContainer = document.getElementById('pickup-district-container');

  const deliveryCountryContainer = document.getElementById('delivery-country-container');
  const deliveryCountrySelect = document.getElementById('deliveryCountry') as HTMLSelectElement | HTMLInputElement | null;
  const deliveryStateSelect = document.getElementById('deliveryState') as HTMLSelectElement | null;
  const deliveryDistrictSelect = document.getElementById('deliveryDistrict') as HTMLSelectElement | null;
  const deliveryDistrictContainer = document.getElementById('delivery-district-container');
  const deliveryTitle = document.getElementById('delivery-title');

  function getLang() {
    return localStorage.getItem('lang') || 'en';
  }

  // Populate state dropdown based on selected country
  function updateStates(countryCode: string, stateSelect: HTMLSelectElement, placeholderKey: string) {
    const country = COUNTRIES_DATA[countryCode];
    const currentLang = getLang();
    const promptText = TRANSLATIONS[currentLang]?.[placeholderKey] || "Select state/region";
    
    stateSelect.innerHTML = `<option value="" disabled selected data-i18n="${placeholderKey}">${promptText}</option>`;
    
    if (country && country.states.length > 0) {
      stateSelect.disabled = false;
      country.states.forEach(s => {
        const option = document.createElement('option');
        option.value = s.name;
        option.textContent = s.name;
        stateSelect.appendChild(option);
      });
    } else {
      stateSelect.disabled = true;
    }
  }

  // Update district dropdown based on selected state (Only for India)
  function updateDistricts(countryCode: string, stateName: string, districtSelect: HTMLSelectElement, placeholderKey: string) {
    const country = COUNTRIES_DATA[countryCode];
    const currentLang = getLang();
    const promptText = TRANSLATIONS[currentLang]?.[placeholderKey] || "Select district";
    
    districtSelect.innerHTML = `<option value="" disabled selected data-i18n="${placeholderKey}">${promptText}</option>`;
    
    if (countryCode === 'IN' && country) {
      const stateObj = country.states.find(s => s.name === stateName);
      if (stateObj && stateObj.districts && stateObj.districts.length > 0) {
        districtSelect.disabled = false;
        stateObj.districts.forEach(dist => {
          const option = document.createElement('option');
          option.value = dist;
          option.textContent = dist;
          districtSelect.appendChild(option);
        });
        return;
      }
    }
    
    districtSelect.disabled = true;
  }

  // Hide/Show district containers conditionally
  function adjustDistrictVisibility(countryCode: string, selectEl: HTMLSelectElement | null, container: HTMLElement | null) {
    if (!selectEl || !container) return;
    if (countryCode === 'IN') {
      container.classList.remove('hidden');
      selectEl.disabled = true;
      selectEl.required = true;
    } else {
      container.classList.add('hidden');
      selectEl.disabled = true;
      selectEl.required = false;
      selectEl.value = "";
    }
  }

  // Handle updates when the origin/pickup country changes
  function handlePickupCountryChange() {
    if (!pickupCountrySelect || !pickupStateSelect) return;
    const country = pickupCountrySelect.value;
    updateStates(country, pickupStateSelect, "select-state-prompt");
    adjustDistrictVisibility(country, pickupDistrictSelect, pickupDistrictContainer);



    // If domestic mode is active, lock delivery country to pickup country
    if (shippingType && shippingType.value === 'domestic') {
      if (deliveryCountrySelect) {
        deliveryCountrySelect.value = country;
      }
      handleDeliveryCountryChange();
    }
  }

  // Handle updates when the destination/delivery country changes
  function handleDeliveryCountryChange() {
    const isDom = shippingType && shippingType.value === 'domestic';
    const activeCountryCode = isDom 
      ? (pickupCountrySelect?.value || 'IN') 
      : (deliveryCountrySelect?.value || '');

    if (deliveryStateSelect) {
      updateStates(activeCountryCode, deliveryStateSelect, "select-state-prompt");
    }
    adjustDistrictVisibility(activeCountryCode, deliveryDistrictSelect, deliveryDistrictContainer);
  }

  // Setup listeners for select updates
  pickupCountrySelect?.addEventListener('change', handlePickupCountryChange);
  deliveryCountrySelect?.addEventListener('change', handleDeliveryCountryChange);

  pickupStateSelect?.addEventListener('change', () => {
    if (pickupCountrySelect && pickupStateSelect && pickupDistrictSelect) {
      updateDistricts(pickupCountrySelect.value, pickupStateSelect.value, pickupDistrictSelect, "select-district-prompt");
    }
  });

  deliveryStateSelect?.addEventListener('change', () => {
    const isDom = shippingType && shippingType.value === 'domestic';
    const activeCountryCode = isDom 
      ? (pickupCountrySelect?.value || 'IN') 
      : (deliveryCountrySelect?.value || '');
      
    if (deliveryStateSelect && deliveryDistrictSelect) {
      updateDistricts(activeCountryCode, deliveryStateSelect.value, deliveryDistrictSelect, "select-district-prompt");
    }
  });

  // Switcher Actions
  tabDomestic?.addEventListener('click', () => {
    if (shippingType) shippingType.value = "domestic";
    
    // UI Classes
    tabDomestic.className = "px-5 py-1.5 rounded-full font-medium text-xs tracking-tight transition-all cursor-pointer bg-primary text-on-primary";
    tabInternational?.setAttribute("class", "px-5 py-1.5 rounded-full font-medium text-xs tracking-tight text-body hover:text-ink transition-all cursor-pointer");
    
    // Visibility
    pickupCountryContainer?.classList.add('hidden');
    deliveryCountryContainer?.classList.add('hidden');
    
    if (pickupCountrySelect) {
      pickupCountrySelect.value = 'IN';
    }

    // Title Translation key update
    if (deliveryTitle) {
      deliveryTitle.setAttribute('data-i18n', 'form-delivery-title-dom');
      const curLang = getLang();
      deliveryTitle.textContent = TRANSLATIONS[curLang]?.["form-delivery-title-dom"] || "Delivery Location (Domestic)";
    }
    
    if (deliveryCountrySelect) {
      deliveryCountrySelect.required = false;
      if (pickupCountrySelect) {
        deliveryCountrySelect.value = pickupCountrySelect.value;
      }
    }
    handlePickupCountryChange();
    handleDeliveryCountryChange();
  });

  tabInternational?.addEventListener('click', () => {
    if (shippingType) shippingType.value = "international";

    // UI Classes
    tabInternational.className = "px-5 py-1.5 rounded-full font-medium text-xs tracking-tight transition-all cursor-pointer bg-primary text-on-primary";
    tabDomestic?.setAttribute("class", "px-5 py-1.5 rounded-full font-medium text-xs tracking-tight text-body hover:text-ink transition-all cursor-pointer");

    // Visibility
    pickupCountryContainer?.classList.remove('hidden');
    deliveryCountryContainer?.classList.remove('hidden');

    if (deliveryTitle) {
      deliveryTitle.setAttribute('data-i18n', 'form-delivery-title-intl');
      const curLang = getLang();
      deliveryTitle.textContent = TRANSLATIONS[curLang]?.["form-delivery-title-intl"] || "Delivery Location (International)";
    }

    if (deliveryCountrySelect) {
      deliveryCountrySelect.required = true;
      if (deliveryCountrySelect.value === pickupCountrySelect?.value) {
        deliveryCountrySelect.value = ""; // Force them to pick a different country
      }
    }
    handlePickupCountryChange();
    handleDeliveryCountryChange();
  });

  // Advanced section toggle
  const advToggle = document.getElementById('advanced-toggle');
  const advSection = document.getElementById('advanced-section');
  const advArrow = document.getElementById('advanced-arrow');

  advToggle?.addEventListener('click', () => {
    const isHidden = advSection?.classList.contains('hidden');
    if (isHidden) {
      advSection?.classList.remove('hidden');
      advArrow?.classList.add('rotate-90');
    } else {
      advSection?.classList.add('hidden');
      advArrow?.classList.remove('rotate-90');
    }
  });

  // Dynamic Multi-Parcel Management
  const parcelsContainer = document.getElementById('parcels-container');
  const addParcelBtn = document.getElementById('add-parcel-btn');

  function updateParcelNumbers() {
    if (!parcelsContainer) return;
    const cards = parcelsContainer.querySelectorAll('.parcel-card');
    const currentLang = getLang();
    const removeLabel = TRANSLATIONS[currentLang]?.["form-parcel-remove"] || "Remove";
    
    cards.forEach((card, index) => {
      const idxSpan = card.querySelector('.parcel-idx');
      if (idxSpan) idxSpan.textContent = (index + 1).toString();

      // Show remove button for all except the first card
      const removeBtn = card.querySelector('.remove-parcel-btn') as HTMLButtonElement | null;
      if (removeBtn) {
        removeBtn.textContent = removeLabel;
        if (cards.length > 1) {
          removeBtn.classList.remove('hidden');
        } else {
          removeBtn.classList.add('hidden');
        }
      }
    });
  }

  // Volumetric Weight Live Preview Handler
  function attachVolumetricPreview(card: HTMLElement) {
    const weightInput = card.querySelector('input[name="parcelWeight"]') as HTMLInputElement | null;
    const unitSelect = card.querySelector('select[name="parcelWeightUnit"]') as HTMLSelectElement | null;
    const lInput = card.querySelector('input[name="parcelLength"]') as HTMLInputElement | null;
    const wInput = card.querySelector('input[name="parcelWidth"]') as HTMLInputElement | null;
    const hInput = card.querySelector('input[name="parcelHeight"]') as HTMLInputElement | null;
    const badge = card.querySelector('.volumetric-preview-badge') as HTMLElement | null;
    const volSummary = card.querySelector('.vol-summary') as HTMLElement | null;
    const volNote = card.querySelector('.vol-chargeable-note') as HTMLElement | null;
    const volTag = card.querySelector('.vol-badge-tag') as HTMLElement | null;

    function calculatePreview() {
      if (!badge || !volSummary || !volNote || !volTag) return;
      const l = parseFloat(lInput?.value || '0');
      const w = parseFloat(wInput?.value || '0');
      const h = parseFloat(hInput?.value || '0');
      const rawWeight = parseFloat(weightInput?.value || '0');
      const unit = unitSelect?.value || 'kg';
      const scaleWeightKg = unit === 'g' ? rawWeight / 1000 : rawWeight;

      if (l > 0 && w > 0 && h > 0) {
        const volWeightKg = Math.round(((l * w * h) / 5000) * 100) / 100;
        const chargeableKg = Math.max(scaleWeightKg > 0 ? scaleWeightKg : 0, volWeightKg);

        badge.classList.remove('hidden');
        if (scaleWeightKg > 0 && volWeightKg > scaleWeightKg) {
          badge.className = "volumetric-preview-badge mt-2.5 p-2.5 rounded-md border border-warning/40 bg-warning-soft/30 text-xs flex items-center justify-between transition-all duration-200";
          volTag.className = "vol-badge-tag px-2 py-0.5 rounded font-mono text-[10px] font-semibold bg-warning/20 text-warning-deep";
          volTag.textContent = "Volumetric Applied";
          volSummary.textContent = `Volumetric: ${volWeightKg.toFixed(2)} kg (Scale: ${scaleWeightKg.toFixed(2)} kg)`;
          volNote.textContent = `Billed on ${chargeableKg.toFixed(2)} kg because box size exceeds scale weight.`;
        } else if (scaleWeightKg > 0) {
          badge.className = "volumetric-preview-badge mt-2.5 p-2.5 rounded-md border border-hairline bg-canvas-soft text-xs flex items-center justify-between transition-all duration-200";
          volTag.className = "vol-badge-tag px-2 py-0.5 rounded font-mono text-[10px] font-semibold bg-canvas-soft-2 text-mute border border-hairline";
          volTag.textContent = "Scale Weight Applied";
          volSummary.textContent = `Volumetric: ${volWeightKg.toFixed(2)} kg • Scale: ${scaleWeightKg.toFixed(2)} kg`;
          volNote.textContent = `Billed on ${chargeableKg.toFixed(2)} kg (actual scale weight).`;
        } else {
          badge.className = "volumetric-preview-badge mt-2.5 p-2.5 rounded-md border border-hairline bg-canvas-soft text-xs flex items-center justify-between transition-all duration-200";
          volTag.className = "vol-badge-tag px-2 py-0.5 rounded font-mono text-[10px] font-semibold bg-canvas-soft-2 text-mute border border-hairline";
          volTag.textContent = "Volumetric Estimate";
          volSummary.textContent = `Volumetric Weight: ${volWeightKg.toFixed(2)} kg`;
          volNote.textContent = `Enter physical scale weight to determine chargeable weight.`;
        }
      } else {
        badge.classList.add('hidden');
      }
    }

    [weightInput, unitSelect, lInput, wInput, hInput].forEach(el => {
      el?.addEventListener('input', calculatePreview);
      el?.addEventListener('change', calculatePreview);
    });
  }

  function bindRemoveEvent(card: HTMLElement) {
    const removeBtn = card.querySelector('.remove-parcel-btn');
    removeBtn?.addEventListener('click', () => {
      card.remove();
      updateParcelNumbers();
    });
  }

  // Bind initial card
  const initialCard = parcelsContainer?.querySelector('.parcel-card') as HTMLElement | null;
  if (initialCard) {
    bindRemoveEvent(initialCard);
    attachVolumetricPreview(initialCard);
  }

  addParcelBtn?.addEventListener('click', () => {
    if (!parcelsContainer) return;
    const currentLang = getLang();

    // Create a new parcel card element
    const newCard = document.createElement('div');
    newCard.className = "parcel-card bg-canvas-soft-2 border border-hairline p-4 rounded-md relative space-y-4 transition-colors duration-200";
    
    // Create categories selection options matching current lang
    const categoryOptions = CATEGORIES.map(cat => {
      const catTrans = TRANSLATIONS[currentLang]?.[`cat-${cat.id}`] || cat.name;
      return `<option value="${cat.id}" data-i18n="cat-${cat.id}">${catTrans}</option>`;
    }).join('');

    const idxLabel = TRANSLATIONS[currentLang]?.["form-parcel-idx"] || "Parcel #";
    const removeLabel = TRANSLATIONS[currentLang]?.["form-parcel-remove"] || "Remove";
    const weightLabel = TRANSLATIONS[currentLang]?.["form-parcel-weight"] || "Parcel Weight";
    const catLabel = TRANSLATIONS[currentLang]?.["form-parcel-category"] || "Parcel Category";
    const selectCatPrompt = TRANSLATIONS[currentLang]?.["select-category-prompt"] || "Select category";
    const dimTitle = TRANSLATIONS[currentLang]?.["form-parcel-dim-title"] || "Dimensions (Optional - For Volumetric Weight)";
    const dimL = TRANSLATIONS[currentLang]?.["form-parcel-dim-l"] || "Length (cm)";
    const dimW = TRANSLATIONS[currentLang]?.["form-parcel-dim-w"] || "Width (cm)";
    const dimH = TRANSLATIONS[currentLang]?.["form-parcel-dim-h"] || "Height (cm)";

    newCard.innerHTML = `
      <div class="flex items-center justify-between border-b border-hairline/60 pb-2">
        <span class="caption-mono text-xs uppercase tracking-wider text-ink font-semibold">
          <span data-i18n="form-parcel-idx">${idxLabel}</span><span class="parcel-idx">2</span>
        </span>
        <button 
          type="button" 
          class="remove-parcel-btn text-xs text-error hover:text-error-deep cursor-pointer focus:outline-none transition-colors duration-150"
          data-i18n="form-parcel-remove"
        >
          ${removeLabel}
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Parcel Weight -->
        <div class="flex flex-col gap-1.5">
          <label class="body-sm-strong text-ink text-xs font-semibold" data-i18n="form-parcel-weight">${weightLabel}</label>
          <div class="flex">
            <input 
              type="number" 
              name="parcelWeight" 
              min="0.01" 
              step="any" 
              placeholder="e.g. 2.5" 
              required 
              class="form-input flex-1 rounded-r-none border-r-0"
            />
            <select 
              name="parcelWeightUnit" 
              class="form-input w-20 rounded-l-none border-l-1 bg-canvas-soft appearance-none pr-6 cursor-pointer"
            >
              <option value="kg">kg</option>
              <option value="g">g</option>
            </select>
          </div>
        </div>

        <!-- Parcel Category -->
        <div class="flex flex-col gap-1.5">
          <label class="body-sm-strong text-ink text-xs font-semibold" data-i18n="form-parcel-category">${catLabel}</label>
          <div class="relative">
            <select name="parcelCategory" required class="form-input w-full appearance-none pr-8">
              <option value="" disabled selected data-i18n="select-category-prompt">${selectCatPrompt}</option>
              ${categoryOptions}
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-mute">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Dimensions -->
      <div class="space-y-2">
        <span class="body-sm-strong text-ink text-xs block font-semibold" data-i18n="form-parcel-dim-title">${dimTitle}</span>
        <div class="grid grid-cols-3 gap-3">
          <div class="flex flex-col gap-1">
            <label class="caption text-mute text-xs" data-i18n="form-parcel-dim-l">${dimL}</label>
            <input type="number" name="parcelLength" min="1" placeholder="L" class="form-input w-full" />
          </div>
          <div class="flex flex-col gap-1">
            <label class="caption text-mute text-xs" data-i18n="form-parcel-dim-w">${dimW}</label>
            <input type="number" name="parcelWidth" min="1" placeholder="W" class="form-input w-full" />
          </div>
          <div class="flex flex-col gap-1">
            <label class="caption text-mute text-xs" data-i18n="form-parcel-dim-h">${dimH}</label>
            <input type="number" name="parcelHeight" min="1" placeholder="H" class="form-input w-full" />
          </div>
        </div>

        <!-- Volumetric Weight Live Preview Badge -->
        <div class="volumetric-preview-badge hidden mt-2.5 p-2.5 rounded-md border text-xs flex items-center justify-between transition-all duration-200">
          <div class="flex items-center gap-2">
            <span class="text-sm">📦</span>
            <div>
              <span class="font-medium vol-summary text-ink">Volumetric Weight: 0 kg</span>
              <span class="block text-[11px] text-mute vol-chargeable-note"></span>
            </div>
          </div>
          <span class="vol-badge-tag px-2 py-0.5 rounded font-mono text-[10px] font-semibold"></span>
        </div>
      </div>
    `;

    parcelsContainer.appendChild(newCard);
    bindRemoveEvent(newCard);
    attachVolumetricPreview(newCard);
    updateParcelNumbers();
  });

  // Re-translate card components when global language changes
  window.addEventListener('language-change', () => {
    updateParcelNumbers();
    
    // Refresh placeholders or option text for category select
    const currentLang = getLang();
    const statePlaceholder = TRANSLATIONS[currentLang]?.["select-state-prompt"] || "Select state/region";
    const districtPlaceholder = TRANSLATIONS[currentLang]?.["select-district-prompt"] || "Select district";
    const countryPlaceholder = TRANSLATIONS[currentLang]?.["select-country-prompt"] || "Select destination country";

    document.querySelectorAll('[data-i18n="select-state-prompt"]').forEach(opt => {
      opt.textContent = statePlaceholder;
    });
    document.querySelectorAll('[data-i18n="select-district-prompt"]').forEach(opt => {
      opt.textContent = districtPlaceholder;
    });
    document.querySelectorAll('[data-i18n="select-country-prompt"]').forEach(opt => {
      opt.textContent = countryPlaceholder;
    });
  });

  // Initialize defaults
  if (courierId === 'delhivery-domestic-in' || courierId === 'professional-domestic-in') {
    const switcher = document.querySelector('.flex.justify-center.mb-8');
    if (switcher) switcher.classList.add('hidden');
    if (shippingType) shippingType.value = "domestic";
  }
  handlePickupCountryChange();

  // URL Query Parameters Pre-fill Handler
  function initQueryParamPrefill() {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      if (!urlParams.toString()) return;

      const typeParam = urlParams.get('type') || urlParams.get('mode');
      const fromParam = urlParams.get('from') || urlParams.get('pickupCountry');
      const toParam = urlParams.get('to') || urlParams.get('deliveryCountry');
      const fromStateParam = urlParams.get('fromState') || urlParams.get('pickupState');
      const toStateParam = urlParams.get('toState') || urlParams.get('deliveryState');
      const weightParam = urlParams.get('weight') || urlParams.get('kg');
      const lengthParam = urlParams.get('length') || urlParams.get('l');
      const widthParam = urlParams.get('width') || urlParams.get('w');
      const heightParam = urlParams.get('height') || urlParams.get('h');
      const catParam = urlParams.get('category') || urlParams.get('cat');

      if (typeParam === 'international' && tabInternational) {
        tabInternational.click();
      } else if (typeParam === 'domestic' && tabDomestic) {
        tabDomestic.click();
      }

      if (fromParam && pickupCountrySelect) {
        pickupCountrySelect.value = fromParam.toUpperCase();
        handlePickupCountryChange();
      }

      if (toParam && deliveryCountrySelect) {
        deliveryCountrySelect.value = toParam.toUpperCase();
        handleDeliveryCountryChange();
      }

      if (fromStateParam && pickupStateSelect) {
        setTimeout(() => {
          pickupStateSelect.value = fromStateParam;
          pickupStateSelect.dispatchEvent(new Event('change'));
        }, 50);
      }

      if (toStateParam && deliveryStateSelect) {
        setTimeout(() => {
          deliveryStateSelect.value = toStateParam;
          deliveryStateSelect.dispatchEvent(new Event('change'));
        }, 50);
      }

      if (initialCard) {
        if (weightParam) {
          const wInput = initialCard.querySelector('input[name="parcelWeight"]') as HTMLInputElement | null;
          if (wInput) wInput.value = weightParam;
        }
        if (lengthParam) {
          const lInput = initialCard.querySelector('input[name="parcelLength"]') as HTMLInputElement | null;
          if (lInput) lInput.value = lengthParam;
        }
        if (widthParam) {
          const wInput = initialCard.querySelector('input[name="parcelWidth"]') as HTMLInputElement | null;
          if (wInput) wInput.value = widthParam;
        }
        if (heightParam) {
          const hInput = initialCard.querySelector('input[name="parcelHeight"]') as HTMLInputElement | null;
          if (hInput) hInput.value = heightParam;
        }
        if (catParam) {
          const cSelect = initialCard.querySelector('select[name="parcelCategory"]') as HTMLSelectElement | null;
          if (cSelect) cSelect.value = catParam;
        }
        const weightInput = initialCard.querySelector('input[name="parcelWeight"]');
        weightInput?.dispatchEvent(new Event('input'));
      }
    } catch (e) {
      console.warn("Could not prefill form parameters:", e);
    }
  }

  initQueryParamPrefill();

  // Route Swap Button (Origin ⇄ Destination) Handler
  const swapRouteBtn = document.getElementById('swap-route-btn');
  const swapIcon = document.getElementById('swap-icon');
  let isSwappedRotation = false;

  swapRouteBtn?.addEventListener('click', () => {
    // Rotation animation
    isSwappedRotation = !isSwappedRotation;
    if (swapIcon) {
      swapIcon.style.transform = isSwappedRotation ? 'rotate(180deg)' : 'rotate(0deg)';
    }

    const isDom = (shippingType?.value || 'domestic') === 'domestic';

    if (isDom) {
      const origPickupState = pickupStateSelect?.value || '';
      const origPickupDistrict = pickupDistrictSelect?.value || '';
      const origDeliveryState = deliveryStateSelect?.value || '';
      const origDeliveryDistrict = deliveryDistrictSelect?.value || '';

      if (origDeliveryState && pickupStateSelect) {
        pickupStateSelect.value = origDeliveryState;
        pickupStateSelect.dispatchEvent(new Event('change'));
        if (origDeliveryDistrict && pickupDistrictSelect) {
          setTimeout(() => {
            pickupDistrictSelect.value = origDeliveryDistrict;
          }, 40);
        }
      }

      if (origPickupState && deliveryStateSelect) {
        deliveryStateSelect.value = origPickupState;
        deliveryStateSelect.dispatchEvent(new Event('change'));
        if (origPickupDistrict && deliveryDistrictSelect) {
          setTimeout(() => {
            deliveryDistrictSelect.value = origPickupDistrict;
          }, 40);
        }
      }
    } else {
      // International swap
      const origPickupCountry = pickupCountrySelect?.value || '';
      const origDeliveryCountry = deliveryCountrySelect?.value || '';
      const origPickupState = pickupStateSelect?.value || '';
      const origDeliveryState = deliveryStateSelect?.value || '';

      if (origDeliveryCountry && pickupCountrySelect) {
        pickupCountrySelect.value = origDeliveryCountry;
        handlePickupCountryChange();
        if (origDeliveryState && pickupStateSelect) {
          setTimeout(() => {
            pickupStateSelect.value = origDeliveryState;
            pickupStateSelect.dispatchEvent(new Event('change'));
          }, 50);
        }
      }

      if (origPickupCountry && deliveryCountrySelect) {
        deliveryCountrySelect.value = origPickupCountry;
        handleDeliveryCountryChange();
        if (origPickupState && deliveryStateSelect) {
          setTimeout(() => {
            deliveryStateSelect.value = origPickupState;
            deliveryStateSelect.dispatchEvent(new Event('change'));
          }, 50);
        }
      }
    }
  });

  // Handle Form Submission
  const form = document.getElementById('shipping-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form || !parcelsContainer) return;

    const formData = new FormData(form);
    
    // Gather all parcels
    const parcelCards = parcelsContainer.querySelectorAll('.parcel-card');
    const parcels: any[] = [];

    parcelCards.forEach(card => {
      const weightInput = card.querySelector('input[name="parcelWeight"]') as HTMLInputElement | null;
      const weightUnitSelect = card.querySelector('select[name="parcelWeightUnit"]') as HTMLSelectElement | null;
      const categorySelect = card.querySelector('select[name="parcelCategory"]') as HTMLSelectElement | null;
      const lengthInput = card.querySelector('input[name="parcelLength"]') as HTMLInputElement | null;
      const widthInput = card.querySelector('input[name="parcelWidth"]') as HTMLInputElement | null;
      const heightInput = card.querySelector('input[name="parcelHeight"]') as HTMLInputElement | null;

      if (weightInput && weightUnitSelect && categorySelect) {
        parcels.push({
          weight: parseFloat(weightInput.value),
          weightUnit: weightUnitSelect.value as 'kg' | 'g',
          category: categorySelect.value,
          length: lengthInput && lengthInput.value ? parseFloat(lengthInput.value) : undefined,
          width: widthInput && widthInput.value ? parseFloat(widthInput.value) : undefined,
          height: heightInput && heightInput.value ? parseFloat(heightInput.value) : undefined
        });
      }
    });

    if (parcels.length === 0) {
      alert("Please add at least one parcel.");
      return;
    }

    const pickupCountry = formData.get('pickupCountry') as string;
    const isDom = (formData.get('type') as 'domestic' | 'international') === 'domestic';
    const deliveryCountry = isDom ? pickupCountry : (formData.get('deliveryCountry') as string);

    // Package shipping form values
    const data = {
      type: (formData.get('type') as 'domestic' | 'international') || 'domestic',
      pickupCountry: pickupCountry,
      pickupState: formData.get('pickupState') as string,
      pickupDistrict: formData.get('pickupDistrict') as string || undefined,
      deliveryCountry: deliveryCountry,
      deliveryState: formData.get('deliveryState') as string,
      deliveryDistrict: formData.get('deliveryDistrict') as string || undefined,
      parcels: parcels,
      insurance: formData.get('insurance') === 'on',
      express: formData.get('express') === 'on',
      pickupRequired: formData.get('pickupRequired') === 'on'
    };

    // Dispatch custom event to ResultsList
    const event = new CustomEvent('calculate-shipping', { detail: data });
    window.dispatchEvent(event);

    // Scroll to results section
    const resultsContainer = document.getElementById('comparison-results-section');
    if (resultsContainer) {
      resultsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
</script>
