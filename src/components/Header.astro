---
// Sticky navigation bar matching Vercel's header style guidelines.
---

<header class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md transition-colors duration-200">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <svg class="h-6 w-6 text-primary transition-transform duration-200 group-hover:scale-105" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
        <line x1="12" y1="22.08" x2="12" y2="12"></line>
      </svg>
      <span class="font-sans font-semibold text-lg tracking-tight text-ink">
        courierprice<span class="text-body font-normal">.com</span>
      </span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-6">
      <a href="/#calculator-anchor" data-i18n="nav-calculator" class="text-sm font-normal text-body hover:text-ink transition-colors px-3 py-1.5 rounded-full hover:bg-canvas-soft-2">Calculator</a>
      <a href="/couriers" data-i18n="nav-couriers" class="text-sm font-normal text-body hover:text-ink transition-colors px-3 py-1.5 rounded-full hover:bg-canvas-soft-2">Couriers</a>
      <a href="/#guides" data-i18n="nav-guides" class="text-sm font-normal text-body hover:text-ink transition-colors px-3 py-1.5 rounded-full hover:bg-canvas-soft-2">Guides</a>
      <a href="/#faq" data-i18n="nav-faq" class="text-sm font-normal text-body hover:text-ink transition-colors px-3 py-1.5 rounded-full hover:bg-canvas-soft-2">FAQs</a>
      <span class="h-4 w-px bg-hairline"></span>
      <a href="/about" data-i18n="nav-about" class="text-sm font-normal text-body hover:text-ink transition-colors px-3 py-1.5 rounded-full hover:bg-canvas-soft-2">About Us</a>
      <a href="/contact" data-i18n="nav-contact" class="text-sm font-normal text-body hover:text-ink transition-colors px-3 py-1.5 rounded-full hover:bg-canvas-soft-2">Contact Us</a>
    </nav>

    <!-- Right-aligned Utility Actions -->
    <div class="flex items-center gap-3">
      <!-- Language Selector Custom Interactive Dropdown -->
      <div class="relative" id="lang-dropdown-wrapper">
        <button
          type="button"
          id="lang-menu-btn"
          class="flex items-center gap-1.5 border border-hairline rounded-md px-2.5 bg-canvas hover:bg-canvas-soft-2 text-ink h-8 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-link/30 transition-all duration-150 cursor-pointer shadow-level-1"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="Select language"
        >
          <svg class="h-3.5 w-3.5 text-body pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          <span id="lang-current-label" class="uppercase tracking-wide font-mono text-[11px] text-ink font-bold">EN</span>
          <svg id="lang-chevron" class="h-3 w-3 text-mute transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu Panel -->
        <div
          id="lang-menu"
          class="hidden absolute right-0 mt-2 w-64 sm:w-72 rounded-xl border border-hairline bg-canvas shadow-level-5 p-1.5 z-50 transition-all duration-200 origin-top-right focus:outline-none"
          role="menu"
          aria-orientation="vertical"
        >
          <div class="px-2.5 py-2 border-b border-hairline flex items-center justify-between">
            <span class="caption-mono uppercase tracking-wider text-[10px] text-mute font-semibold">Select Language</span>
            <span class="caption-mono text-[10px] text-mute">6 Languages</span>
          </div>

          <div class="py-1 space-y-0.5" role="none">
            <!-- English -->
            <button
              type="button"
              data-lang="en"
              class="lang-option w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left text-xs transition-colors duration-150 hover:bg-canvas-soft-2 cursor-pointer group"
              role="menuitem"
            >
              <div class="flex items-center gap-2.5">
                <span class="font-mono text-[10px] font-bold px-1.5 py-0.5 rounded bg-canvas-soft border border-hairline text-ink group-hover:border-hairline-strong">EN</span>
                <div>
                  <div class="font-medium text-ink">English</div>
                  <div class="text-[10px] text-mute">Global (US / UK)</div>
                </div>
              </div>
              <svg class="lang-check h-4 w-4 text-link hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>

            <!-- Hindi -->
            <button
              type="button"
              data-lang="hi"
              class="lang-option w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left text-xs transition-colors duration-150 hover:bg-canvas-soft-2 cursor-pointer group"
              role="menuitem"
            >
              <div class="flex items-center gap-2.5">
                <span class="font-mono text-[10px] font-bold px-1.5 py-0.5 rounded bg-canvas-soft border border-hairline text-ink group-hover:border-hairline-strong">HI</span>
                <div>
                  <div class="font-medium text-ink font-sans">हिन्दी</div>
                  <div class="text-[10px] text-mute">Hindi (India)</div>
                </div>
              </div>
              <svg class="lang-check h-4 w-4 text-link hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>

            <!-- Spanish -->
            <button
              type="button"
              data-lang="es"
              class="lang-option w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left text-xs transition-colors duration-150 hover:bg-canvas-soft-2 cursor-pointer group"
              role="menuitem"
            >
              <div class="flex items-center gap-2.5">
                <span class="font-mono text-[10px] font-bold px-1.5 py-0.5 rounded bg-canvas-soft border border-hairline text-ink group-hover:border-hairline-strong">ES</span>
                <div>
                  <div class="font-medium text-ink">Español</div>
                  <div class="text-[10px] text-mute">Spanish</div>
                </div>
              </div>
              <svg class="lang-check h-4 w-4 text-link hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>

            <!-- French -->
            <button
              type="button"
              data-lang="fr"
              class="lang-option w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left text-xs transition-colors duration-150 hover:bg-canvas-soft-2 cursor-pointer group"
              role="menuitem"
            >
              <div class="flex items-center gap-2.5">
                <span class="font-mono text-[10px] font-bold px-1.5 py-0.5 rounded bg-canvas-soft border border-hairline text-ink group-hover:border-hairline-strong">FR</span>
                <div>
                  <div class="font-medium text-ink">Français</div>
                  <div class="text-[10px] text-mute">French</div>
                </div>
              </div>
              <svg class="lang-check h-4 w-4 text-link hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>

            <!-- German -->
            <button
              type="button"
              data-lang="de"
              class="lang-option w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left text-xs transition-colors duration-150 hover:bg-canvas-soft-2 cursor-pointer group"
              role="menuitem"
            >
              <div class="flex items-center gap-2.5">
                <span class="font-mono text-[10px] font-bold px-1.5 py-0.5 rounded bg-canvas-soft border border-hairline text-ink group-hover:border-hairline-strong">DE</span>
                <div>
                  <div class="font-medium text-ink">Deutsch</div>
                  <div class="text-[10px] text-mute">German</div>
                </div>
              </div>
              <svg class="lang-check h-4 w-4 text-link hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>

            <!-- Arabic -->
            <button
              type="button"
              data-lang="ar"
              class="lang-option w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left text-xs transition-colors duration-150 hover:bg-canvas-soft-2 cursor-pointer group"
              role="menuitem"
            >
              <div class="flex items-center gap-2.5">
                <span class="font-mono text-[10px] font-bold px-1.5 py-0.5 rounded bg-canvas-soft border border-hairline text-ink group-hover:border-hairline-strong">AR</span>
                <div>
                  <div class="font-medium text-ink font-sans">العربية</div>
                  <div class="text-[10px] text-mute">Arabic</div>
                </div>
              </div>
              <svg class="lang-check h-4 w-4 text-link hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Dark Mode Switcher -->
      <button 
        id="theme-toggle" 
        class="inline-flex items-center justify-center h-8 w-8 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft-2 text-ink cursor-pointer focus:outline-none focus:ring-2 focus:ring-link/50 transition-colors shadow-level-1"
        aria-label="Toggle visual theme"
      >
        <!-- Sun (visible in dark) -->
        <svg id="theme-toggle-light-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon (visible in light) -->
        <svg id="theme-toggle-dark-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Sponsor Link (Desktop/Tablet Only) -->
      <a href="https://ko-fi.com/bitsharc" target="_blank" rel="noopener noreferrer" class="hidden sm:flex text-xs font-mono text-[#888888] hover:text-ink transition-colors duration-200 items-center justify-center gap-1.5 ml-4 mr-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" x2="6" y1="2" y2="4"/><line x1="10" x2="10" y1="2" y2="4"/><line x1="14" x2="14" y1="2" y2="4"/></svg>
        Sponsor
      </a>

      <!-- Nav Sign Up (Vercel Style) -->
      <a href="/#calculator-anchor" data-i18n="nav-cta-compare" class="hidden sm:inline-flex items-center justify-center bg-primary text-on-primary text-xs font-medium rounded-sm px-3 h-7 hover:opacity-90 active:scale-98 transition-all">
        Compare Now
      </a>
      
      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn" 
        class="inline-flex md:hidden items-center justify-center h-8 w-8 rounded-sm border border-hairline bg-canvas hover:bg-canvas-soft-2 text-ink cursor-pointer focus:outline-none"
        aria-label="Toggle mobile menu"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12" id="menu-line-1"></line>
          <line x1="3" y1="6" x2="21" y2="6" id="menu-line-2"></line>
          <line x1="3" y1="18" x2="21" y2="18" id="menu-line-3"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden w-full border-t border-hairline bg-canvas transition-all duration-200">
    <div class="flex flex-col gap-2 p-4">
      <a href="/#calculator-anchor" data-i18n="nav-calculator" class="text-sm font-normal text-body hover:text-ink p-2 rounded-md hover:bg-canvas-soft-2">Calculator</a>
      <a href="/couriers" data-i18n="nav-couriers" class="text-sm font-normal text-body hover:text-ink p-2 rounded-md hover:bg-canvas-soft-2">Couriers</a>
      <a href="/#guides" data-i18n="nav-guides" class="text-sm font-normal text-body hover:text-ink p-2 rounded-md hover:bg-canvas-soft-2">Guides</a>
      <a href="/#faq" data-i18n="nav-faq" class="text-sm font-normal text-body hover:text-ink p-2 rounded-md hover:bg-canvas-soft-2">FAQs</a>
      <a href="/about" data-i18n="nav-about" class="text-sm font-normal text-body hover:text-ink p-2 rounded-md hover:bg-canvas-soft-2">About Us</a>
      <a href="/contact" data-i18n="nav-contact" class="text-sm font-normal text-body hover:text-ink p-2 rounded-md hover:bg-canvas-soft-2">Contact Us</a>
      <a href="/#calculator-anchor" data-i18n="nav-cta-compare" class="flex items-center justify-center bg-primary text-on-primary text-sm font-medium rounded-sm p-2 w-full mt-2 hover:opacity-90">
        Compare Now
      </a>
    </div>
  </div>
</header>

<script>
  // Theme Toggle Script
  const themeToggleBtn = document.getElementById('theme-toggle');
  const lightIcon = document.getElementById('theme-toggle-light-icon');
  const darkIcon = document.getElementById('theme-toggle-dark-icon');

  function updateIcons() {
    if (document.documentElement.classList.contains('dark')) {
      lightIcon?.classList.remove('hidden');
      darkIcon?.classList.add('hidden');
    } else {
      lightIcon?.classList.add('hidden');
      darkIcon?.classList.remove('hidden');
    }
  }

  // Initial update
  updateIcons();

  themeToggleBtn?.addEventListener('click', () => {
    if (document.documentElement.classList.contains('dark')) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
    updateIcons();
    // Dispatch event so other parts of the site can adapt if needed
    window.dispatchEvent(new Event('theme-change'));
  });

  // Mobile Menu Toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close menu on link click
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });

  // Custom Interactive Language Dropdown Handler
  const langWrapper = document.getElementById('lang-dropdown-wrapper');
  const langMenuBtn = document.getElementById('lang-menu-btn');
  const langMenu = document.getElementById('lang-menu');
  const langChevron = document.getElementById('lang-chevron');
  const langCurrentLabel = document.getElementById('lang-current-label');
  const langOptions = document.querySelectorAll<HTMLButtonElement>('.lang-option');

  const updateActiveLangUI = (currentLang: string) => {
    if (langCurrentLabel) {
      langCurrentLabel.textContent = currentLang.toUpperCase();
    }
    langOptions.forEach(opt => {
      const code = opt.getAttribute('data-lang');
      const check = opt.querySelector('.lang-check');
      const isSelected = code === currentLang;
      if (isSelected) {
        opt.classList.add('bg-canvas-soft-2', 'font-semibold');
        check?.classList.remove('hidden');
      } else {
        opt.classList.remove('bg-canvas-soft-2', 'font-semibold');
        check?.classList.add('hidden');
      }
    });
  };

  const openLangMenu = () => {
    langMenu?.classList.remove('hidden');
    langMenuBtn?.setAttribute('aria-expanded', 'true');
    langChevron?.classList.add('rotate-180');
  };

  const closeLangMenu = () => {
    langMenu?.classList.add('hidden');
    langMenuBtn?.setAttribute('aria-expanded', 'false');
    langChevron?.classList.remove('rotate-180');
  };

  const toggleLangMenu = () => {
    const isExpanded = langMenuBtn?.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeLangMenu();
    } else {
      openLangMenu();
    }
  };

  langMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleLangMenu();
  });

  // Select language handler
  langOptions.forEach(opt => {
    opt.addEventListener('click', () => {
      const lang = opt.getAttribute('data-lang') || 'en';
      updateActiveLangUI(lang);
      closeLangMenu();
      if ((window as any).applyLanguage) {
        (window as any).applyLanguage(lang);
      }
    });
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (langWrapper && !langWrapper.contains(e.target as Node)) {
      closeLangMenu();
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeLangMenu();
    }
  });

  // Initial active language sync
  const initialLang = localStorage.getItem('lang') || 'en';
  updateActiveLangUI(initialLang);

  // Sync with global event
  window.addEventListener('language-change', (e: any) => {
    if (e.detail) {
      updateActiveLangUI(e.detail);
    }
  });
</script>
