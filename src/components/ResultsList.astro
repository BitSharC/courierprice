---
// src/components/ResultsList.astro
interface Props {
  courierId?: string;
}

const { courierId = "" } = Astro.props;

let titleKey = 'results-title';
let titleText = 'Available Options.';
let subtitleKey = 'results-subtitle';
let subtitleText = 'Rates are estimates based on standard courier calculations.';

if (courierId === 'delhivery-domestic-in') {
  titleKey = 'results-title-delhivery';
  titleText = 'Estimated Delhivery Shipping Cost';
  subtitleKey = 'results-subtitle-delhivery';
  subtitleText = 'Estimated courier charges for Delhivery Surface and Express services.';
} else if (courierId === 'professional-domestic-in') {
  titleKey = 'results-title-professional';
  titleText = 'Estimated Professional Courier Cost';
  subtitleKey = 'results-subtitle-professional';
  subtitleText = 'Estimated shipping charges for Professional Courier Standard and Express services.';
} else if (courierId === 'dtdc-domestic-in') {
  titleKey = 'results-title-dtdc';
  titleText = 'Estimated DTDC Shipping Cost';
  subtitleKey = 'results-subtitle-dtdc';
  subtitleText = 'Estimated courier charges for DTDC Lite / Surface and Air Express services.';
} else if (courierId === 'indiapost-domestic-in') {
  titleKey = 'results-title-speedpost';
  titleText = 'Estimated India Post Speed Post Cost';
  subtitleKey = 'results-subtitle-speedpost';
  subtitleText = 'Official estimated tariffs for India Post Standard Parcel and Speed Post Priority.';
} else if (courierId === 'bluedart-domestic-in') {
  titleKey = 'results-title-bluedart';
  titleText = 'Estimated Blue Dart Shipping Cost';
  subtitleKey = 'results-subtitle-bluedart';
  subtitleText = 'Estimated freight charges for Blue Dart Surface and Apex Air Express services.';
}
---

<div id="comparison-results-section" data-courier-id={courierId} class="w-full space-y-8 scroll-mt-20 hidden">
  
  <!-- Structured Printable PDF Quotation Sheet (Rendered only on Print / PDF export) -->
  <div id="printable-quote-sheet" class="print-only"></div>

  <!-- Section Title -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-hairline pb-4 transition-colors duration-200">
    <div>
      <h2 class="display-lg text-ink font-semibold" data-i18n={titleKey}>
        {titleText}
      </h2>
      <p class="body-sm text-body mt-1" data-i18n={subtitleKey}>
        {subtitleText}
      </p>
    </div>
    
    {!courierId && (
      <div class="sort-container flex items-center gap-2 border border-hairline rounded-full p-1 bg-canvas shadow-level-1 text-sm transition-colors duration-200">
        <button 
          type="button" 
          id="sort-price" 
          class="px-4 py-1.5 rounded-full font-medium text-xs tracking-tight transition-colors cursor-pointer bg-primary text-on-primary"
          data-i18n="results-sort-price"
        >
          Lowest Price
        </button>
        <button 
          type="button" 
          id="sort-speed" 
          class="px-4 py-1.5 rounded-full font-medium text-xs tracking-tight text-body hover:text-ink transition-colors cursor-pointer"
          data-i18n="results-sort-speed"
        >
          Fastest Delivery
        </button>
        <button 
          type="button" 
          id="sort-rating" 
          class="px-4 py-1.5 rounded-full font-medium text-xs tracking-tight text-body hover:text-ink transition-colors cursor-pointer"
          data-i18n="results-sort-rating"
        >
          Best Rated
        </button>
      </div>
    )}
  </div>

  <!-- Shipment Summary Banner -->
  <div id="shipment-summary-banner"></div>

  {courierId !== 'delhivery-domestic-in' && courierId !== 'professional-domestic-in' && (
    <div id="smart-recommendation-card" class="bg-canvas-soft border border-hairline rounded-lg p-6 shadow-level-2 transition-colors duration-200">
      <div class="flex items-start gap-4">
        <div class="p-2 bg-link/10 text-link rounded-md">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <div>
          <h3 class="body-md-strong text-ink" data-i18n="results-smart-rec">Smart recommendation</h3>
          <p id="recommendation-text" class="body-sm text-body mt-1 leading-relaxed">
            Comparing rates for your shipment...
          </p>
        </div>
      </div>
    </div>
  )}

  <!-- Comparison Cards Grid / Container -->
  <div id="estimates-list" class="space-y-4">
    <!-- Dynamic Cards Will Be Inserted Here -->
  </div>

  <!-- Disclaimer -->
  <div class="mt-8 pt-4 border-t border-hairline text-center">
    <p class="text-xs text-mute leading-relaxed" data-i18n={courierId === 'delhivery-domestic-in' ? 'results-disclaimer-delhivery' : (courierId === 'professional-domestic-in' ? 'results-disclaimer-professional' : 'results-disclaimer')}>
      {courierId === 'delhivery-domestic-in' ? 'CourierPrice provides independent shipping estimates for informational purposes. The estimated price is not an official Delhivery quote and may differ from the final amount charged by Delhivery.' : (courierId === 'professional-domestic-in' ? 'CourierPrice provides independent shipping estimates for informational purposes. The estimated price is not an official quote from The Professional Couriers and may differ from the final amount charged by the courier.' : 'Prices are estimated based on shipment details, route and carrier pricing rules. Actual courier quotations may vary.')}
    </p>
  </div>

  <!-- Floating Toast Feedback for Shared Quotes -->
  <div id="share-toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-300 flex items-center gap-2.5 bg-ink text-canvas text-xs font-semibold px-4 py-2.5 rounded-full shadow-level-5">
    <svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
    </svg>
    <span id="share-toast-msg">Quote link copied to clipboard!</span>
  </div>
</div>

<script>
  import { getEstimates, type CourierEstimate, type ShippingInput } from '../utils/calculator';
  import { TRANSLATIONS } from '../utils/translations';
  import { COUNTRIES_DATA } from '../utils/countryData';

  const resultsSection = document.getElementById('comparison-results-section');
  const courierId = resultsSection?.getAttribute('data-courier-id') || '';

  // Component State
  let currentEstimates: CourierEstimate[] = [];
  let currentInput: ShippingInput | null = null;
  let currentSort: 'price' | 'speed' | 'rating' = 'price';

  // DOM elements
  const estimatesList = document.getElementById('estimates-list');
  const recommendationText = document.getElementById('recommendation-text');
  const summaryBanner = document.getElementById('shipment-summary-banner');
  const sortPriceBtn = document.getElementById('sort-price');
  const sortSpeedBtn = document.getElementById('sort-speed');
  const sortRatingBtn = document.getElementById('sort-rating');

  // Helper variables for formatting summaries
  let totalParcelsCount = 0;
  let totalActualWeight = 0;
  let routeStr = '';

  function getLang() {
    return localStorage.getItem('lang') || 'en';
  }

  // Localized badge texts helper
  const BADGES_TRANSLATIONS: Record<string, Record<string, string>> = {
    cheapest: {
      en: "Cheapest", hi: "सबसे सस्ता", es: "Más barato", fr: "Moins cher", de: "Günstigste", ar: "الأرخص"
    },
    fastest: {
      en: "Fastest", hi: "सबसे तेज़", es: "Más rápido", fr: "Plus rapide", de: "Schnellste", ar: "الأسرع"
    },
    value: {
      en: "Best Value", hi: "सर्वोत्तम मूल्य", es: "Mejor valor", fr: "Meilleur rapport q/p", de: "Beste Wahl", ar: "أفضل قيمة"
    }
  };

  // Listen to calculations event
  window.addEventListener('calculate-shipping', (event: any) => {
    const input = event.detail as ShippingInput;
    currentInput = input;

    // Calculate total summary metrics
    totalParcelsCount = input.parcels.length;
    totalActualWeight = input.parcels.reduce((sum, p) => {
      let w = p.weight;
      if (p.weightUnit === 'g') w /= 1000;
      return sum + w;
    }, 0);
    
    // Construct localized route representation
    const pickupCountryName = COUNTRIES_DATA[input.pickupCountry]?.name || input.pickupCountry;
    const deliveryCountryName = COUNTRIES_DATA[input.deliveryCountry]?.name || input.deliveryCountry;

    const pickupLoc = input.pickupCountry === 'IN' 
      ? `${input.pickupDistrict}, ${input.pickupState}` 
      : `${input.pickupState}, ${pickupCountryName}`;
      
    const deliveryLoc = input.deliveryCountry === 'IN'
      ? `${input.deliveryDistrict}, ${input.deliveryState}`
      : `${input.deliveryState}, ${deliveryCountryName}`;

    routeStr = `${pickupLoc} ➔ ${deliveryLoc}`;

    if (courierId === 'delhivery-domestic-in') {
      // Calculate Surface (express = false)
      const inputSurface = { ...input, express: false };
      const estimatesSurface = getEstimates(inputSurface).filter(e => e.id === 'delhivery-domestic-in');
      
      // Calculate Express (express = true)
      const inputExpress = { ...input, express: true };
      const estimatesExpress = getEstimates(inputExpress).filter(e => e.id === 'delhivery-domestic-in');

      currentEstimates = [];

      if (estimatesSurface.length > 0) {
        const surfaceEst = { ...estimatesSurface[0] };
        surfaceEst.id = 'delhivery-surface';
        surfaceEst.name = 'Delhivery Surface';
        surfaceEst.recommendationBadge = 'cheapest';
        currentEstimates.push(surfaceEst);
      }

      if (estimatesExpress.length > 0) {
        const expressEst = { ...estimatesExpress[0] };
        expressEst.id = 'delhivery-express';
        expressEst.name = 'Delhivery Express';
        expressEst.recommendationBadge = 'fastest';
        currentEstimates.push(expressEst);
      }
    } else if (courierId === 'professional-domestic-in') {
      // Calculate Standard (express = false)
      const inputSurface = { ...input, express: false };
      const estimatesSurface = getEstimates(inputSurface).filter(e => e.id === 'professional-domestic-in');
      
      // Calculate Express (express = true)
      const inputExpress = { ...input, express: true };
      const estimatesExpress = getEstimates(inputExpress).filter(e => e.id === 'professional-domestic-in');

      currentEstimates = [];

      if (estimatesSurface.length > 0) {
        const surfaceEst = { ...estimatesSurface[0] };
        surfaceEst.id = 'professional-standard';
        surfaceEst.name = 'Professional Courier Standard';
        surfaceEst.recommendationBadge = 'cheapest';
        currentEstimates.push(surfaceEst);
      }

      if (estimatesExpress.length > 0) {
        const expressEst = { ...estimatesExpress[0] };
        expressEst.id = 'professional-express';
        expressEst.name = 'Professional Courier Express';
        expressEst.recommendationBadge = 'fastest';
        currentEstimates.push(expressEst);
      }
    } else if (courierId === 'dtdc-domestic-in') {
      // DTDC Lite vs Express
      const inputLite = { ...input, express: false };
      const estimatesLite = getEstimates(inputLite).filter(e => e.id === 'dtdc-domestic-in');

      const inputExpress = { ...input, express: true };
      const estimatesExpress = getEstimates(inputExpress).filter(e => e.id === 'dtdc-domestic-in');

      currentEstimates = [];

      if (estimatesLite.length > 0) {
        const liteEst = { ...estimatesLite[0] };
        liteEst.id = 'dtdc-lite';
        liteEst.name = 'DTDC Lite (Surface Cargo)';
        liteEst.recommendationBadge = 'cheapest';
        currentEstimates.push(liteEst);
      }

      if (estimatesExpress.length > 0) {
        const expressEst = { ...estimatesExpress[0] };
        expressEst.id = 'dtdc-express';
        expressEst.name = 'DTDC Plus (Air Express)';
        expressEst.recommendationBadge = 'fastest';
        currentEstimates.push(expressEst);
      }
    } else if (courierId === 'indiapost-domestic-in') {
      // India Post Standard vs Speed Post Priority
      const inputStandard = { ...input, express: false };
      const estimatesStandard = getEstimates(inputStandard).filter(e => e.id === 'indiapost-domestic-in');

      const inputSpeed = { ...input, express: true };
      const estimatesSpeed = getEstimates(inputSpeed).filter(e => e.id === 'indiapost-domestic-in');

      currentEstimates = [];

      if (estimatesStandard.length > 0) {
        const stdEst = { ...estimatesStandard[0] };
        stdEst.id = 'indiapost-parcel';
        stdEst.name = 'India Post Standard Parcel';
        stdEst.recommendationBadge = 'cheapest';
        currentEstimates.push(stdEst);
      }

      if (estimatesSpeed.length > 0) {
        const speedEst = { ...estimatesSpeed[0] };
        speedEst.id = 'indiapost-speedpost';
        speedEst.name = 'India Post Speed Post Priority';
        speedEst.recommendationBadge = 'fastest';
        currentEstimates.push(speedEst);
      }
    } else if (courierId === 'bluedart-domestic-in') {
      // Blue Dart Surface vs Apex Air Express
      const inputSurface = { ...input, express: false };
      const estimatesSurface = getEstimates(inputSurface).filter(e => e.id === 'bluedart-domestic-in');

      const inputApex = { ...input, express: true };
      const estimatesApex = getEstimates(inputApex).filter(e => e.id === 'bluedart-domestic-in');

      currentEstimates = [];

      if (estimatesSurface.length > 0) {
        const surfaceEst = { ...estimatesSurface[0] };
        surfaceEst.id = 'bluedart-surface';
        surfaceEst.name = 'Blue Dart Surface Cargo';
        surfaceEst.recommendationBadge = 'cheapest';
        currentEstimates.push(surfaceEst);
      }

      if (estimatesApex.length > 0) {
        const apexEst = { ...estimatesApex[0] };
        apexEst.id = 'bluedart-apex';
        apexEst.name = 'Blue Dart Apex Air Express';
        apexEst.recommendationBadge = 'fastest';
        currentEstimates.push(apexEst);
      }
    } else {
      // Calculate estimates
      currentEstimates = getEstimates(input);
      
      // Sort initially by lowest price
      currentSort = 'price';
      updateSortButtonStyles();
      sortEstimates();
    }

    // Render results
    renderResults();
    
    // Show sections
    resultsSection?.classList.remove('hidden');
  });

  // Re-render immediately on language switch
  window.addEventListener('language-change', () => {
    if (currentInput) {
      // Re-evaluate route string with potentially translated terms if necessary
      const pickupCountryName = COUNTRIES_DATA[currentInput.pickupCountry]?.name || currentInput.pickupCountry;
      const deliveryCountryName = COUNTRIES_DATA[currentInput.deliveryCountry]?.name || currentInput.deliveryCountry;

      const pickupLoc = currentInput.pickupCountry === 'IN' 
        ? `${currentInput.pickupDistrict}, ${currentInput.pickupState}` 
        : `${currentInput.pickupState}, ${pickupCountryName}`;
        
      const deliveryLoc = currentInput.deliveryCountry === 'IN'
        ? `${currentInput.deliveryDistrict}, ${currentInput.deliveryState}`
        : `${currentInput.deliveryState}, ${deliveryCountryName}`;

      routeStr = `${pickupLoc} ➔ ${deliveryLoc}`;

      renderResults();
    }
  });

  // Sorting Listeners
  sortPriceBtn?.addEventListener('click', () => {
    currentSort = 'price';
    updateSortButtonStyles();
    sortEstimates();
    renderResults();
  });

  sortSpeedBtn?.addEventListener('click', () => {
    currentSort = 'speed';
    updateSortButtonStyles();
    sortEstimates();
    renderResults();
  });

  sortRatingBtn?.addEventListener('click', () => {
    currentSort = 'rating';
    updateSortButtonStyles();
    sortEstimates();
    renderResults();
  });

  function updateSortButtonStyles() {
    const buttons = [
      { btn: sortPriceBtn, type: 'price' },
      { btn: sortSpeedBtn, type: 'speed' },
      { btn: sortRatingBtn, type: 'rating' }
    ];

    buttons.forEach(({ btn, type }) => {
      if (!btn) return;
      if (currentSort === type) {
        btn.className = "px-4 py-1.5 rounded-full font-medium text-xs tracking-tight transition-colors cursor-pointer bg-primary text-on-primary";
      } else {
        btn.className = "px-4 py-1.5 rounded-full font-medium text-xs tracking-tight text-body hover:text-ink transition-colors cursor-pointer";
      }
    });
  }

  function sortEstimates() {
    if (currentSort === 'price') {
      currentEstimates.sort((a, b) => a.estimatedPrice - b.estimatedPrice);
    } else if (currentSort === 'speed') {
      currentEstimates.sort((a, b) => {
        if (a.estimatedDays === b.estimatedDays) {
          return b.reliabilityScore - a.reliabilityScore;
        }
        return a.estimatedDays - b.estimatedDays;
      });
    } else if (currentSort === 'rating') {
      currentEstimates.sort((a, b) => b.reliabilityScore - a.reliabilityScore);
    }
  }

  function generateRecommendation() {
    if (!currentInput || currentEstimates.length === 0) return '';

    const lang = getLang();
    const cheapest = [...currentEstimates].sort((a, b) => a.estimatedPrice - b.estimatedPrice)[0];
    const fastest = [...currentEstimates].sort((a, b) => a.estimatedDays - b.estimatedDays)[0];
    
    // Value index calculation
    const bestValue = [...currentEstimates].sort((a, b) => {
      const valA = (a.reliabilityScore * 1000) / ((a.estimatedPrice / 100) * a.estimatedDays);
      const valB = (b.reliabilityScore * 1000) / ((b.estimatedPrice / 100) * b.estimatedDays);
      return valB - valA;
    })[0];

    const currencySymbol = cheapest.currencySymbol;
    const parcelCountTrans = TRANSLATIONS[lang]?.[totalParcelsCount === 1 ? 'results-parcel-count' : 'results-parcels-count'] || (totalParcelsCount === 1 ? 'parcel' : 'parcels');
    const weightStr = `${totalParcelsCount} ${parcelCountTrans} (${totalActualWeight.toFixed(2)} kg)`;
    const pathStr = routeStr;

    // Direct match: cheapest is also fastest
    if (cheapest.id === fastest.id) {
      let tpl = TRANSLATIONS[lang]?.[`results-rec-both`] || "For your {weight} shipment from {route}, {name} is both the fastest and cheapest option available, offering superb value at {price} in {days} days.";
      return tpl
        .replace('{weight}', `<strong>${weightStr}</strong>`)
        .replace('{route}', `<strong>${pathStr}</strong>`)
        .replace('{name}', `<strong>${cheapest.name}</strong>`)
        .replace('{price}', `${currencySymbol}${cheapest.estimatedPrice}`)
        .replace('{days}', `${cheapest.estimatedDays}`);
    }
    
    // Sorted by Speed priority
    if (currentSort === 'speed') {
      let tpl = TRANSLATIONS[lang]?.[`results-rec-speed`] || "If delivery time is critical, {name} delivers in {days} days for {price}. Otherwise, you can save {diff} by choosing {cheapest}.";
      const diffVal = Math.round((fastest.estimatedPrice - cheapest.estimatedPrice) * 100) / 100;
      return tpl
        .replace('{name}', `<strong>${fastest.name}</strong>`)
        .replace('{days}', `${fastest.estimatedDays}`)
        .replace('{price}', `${currencySymbol}${fastest.estimatedPrice}`)
        .replace('{diff}', `${currencySymbol}${diffVal}`)
        .replace('{cheapest}', `${cheapest.name}`);
    }

    // Default value preference recommendation
    let tpl = TRANSLATIONS[lang]?.[`results-rec-value`] || "For your {weight} shipment from {route}, {name} provides the best balance, delivering in {days} days for {price}. For the absolute lowest price, choose {cheapest} at {cheapestPrice}.";
    return tpl
      .replace('{weight}', `<strong>${weightStr}</strong>`)
      .replace('{route}', `<strong>${pathStr}</strong>`)
      .replace('{name}', `<strong>${bestValue.name}</strong>`)
      .replace('{days}', `${bestValue.estimatedDays}`)
      .replace('{price}', `<strong>${currencySymbol}${bestValue.estimatedPrice}</strong>`)
      .replace('{cheapest}', `<strong>${cheapest.name}</strong>`)
      .replace('{cheapestPrice}', `${currencySymbol}${cheapest.estimatedPrice}`);
  }

  function renderResults() {
    if (!estimatesList || !currentInput) return;
    const lang = getLang();

    // Render summary banner
    if (summaryBanner) {
      const typeLabel = TRANSLATIONS[lang]?.[`results-shipment-type`] || "Shipment Type";
      const routeLabel = TRANSLATIONS[lang]?.[`results-route`] || "Route";
      const consLabel = TRANSLATIONS[lang]?.[`results-consignment`] || "Consignment";
      const weightLabel = TRANSLATIONS[lang]?.[`results-total-weight`] || "Total Weight";
      
      const typeTrans = TRANSLATIONS[lang]?.[`form-tab-${currentInput.type}`] || currentInput.type;
      const parcelCountTrans = TRANSLATIONS[lang]?.[totalParcelsCount === 1 ? 'results-parcel-count' : 'results-parcels-count'] || (totalParcelsCount === 1 ? 'parcel' : 'parcels');

      const isDedicatedSingleCourier = ['delhivery-domestic-in', 'professional-domestic-in', 'dtdc-domestic-in', 'indiapost-domestic-in', 'bluedart-domestic-in'].includes(courierId || '');

      if (isDedicatedSingleCourier) {
        let totalVolumetricWeight = 0;
        let hasVolumetric = false;
        currentInput.parcels.forEach(p => {
          if (p.length && p.width && p.height) {
            totalVolumetricWeight += (p.length * p.width * p.height) / 5000;
            hasVolumetric = true;
          }
        });
        const totalChargeableWeight = Math.max(0.5, Math.max(totalActualWeight, totalVolumetricWeight));

        summaryBanner.innerHTML = `
          <div class="bg-canvas border border-hairline rounded-lg px-5 py-4 flex flex-col md:flex-row gap-x-8 gap-y-3 justify-between items-start md:items-center text-xs text-body transition-colors duration-200">
            <div class="flex items-center gap-2">
              <span class="inline-block h-2 w-2 rounded-full bg-link"></span>
              <span class="font-medium text-ink">${routeLabel}:</span>
              <span class="text-body font-medium">${routeStr}</span>
            </div>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
              <div class="flex items-center gap-1.5">
                <span class="font-medium text-ink">Actual Weight:</span>
                <span class="text-body">${totalActualWeight.toFixed(2)} kg</span>
              </div>
              ${hasVolumetric ? `
              <div class="flex items-center gap-1.5">
                <span class="font-medium text-ink">Volumetric Weight:</span>
                <span class="text-body">${totalVolumetricWeight.toFixed(2)} kg</span>
              </div>
              ` : ''}
              <div class="flex items-center gap-1.5">
                <span class="font-medium text-ink">Chargeable Weight:</span>
                <span class="font-semibold text-primary">${totalChargeableWeight.toFixed(2)} kg</span>
              </div>
              <div class="flex items-center gap-2 ml-auto">
                <button
                  type="button"
                  id="print-quote-btn"
                  class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-hairline bg-canvas-soft-2 hover:bg-canvas text-body hover:text-ink text-xs font-semibold shadow-level-1 transition-all cursor-pointer active:scale-95"
                  title="Print or Save Quote as PDF"
                >
                  <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                  </svg>
                  <span>Print / PDF</span>
                </button>
                <button
                  type="button"
                  id="share-quote-btn"
                  class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-hairline bg-canvas-soft-2 hover:bg-canvas text-body hover:text-ink text-xs font-semibold shadow-level-1 transition-all cursor-pointer active:scale-95"
                  title="Copy shareable link for this quote"
                >
                  <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                  </svg>
                  <span>Share Quote</span>
                </button>
              </div>
            </div>
          </div>
        `;
      } else {
        summaryBanner.innerHTML = `
          <div class="bg-canvas border border-hairline rounded-lg px-5 py-4 flex flex-wrap gap-x-8 gap-y-3 justify-between items-center text-xs text-body transition-colors duration-200">
