---
// src/components/Footer.astro
// Clean, minimal 4-column footer matching Vercel style.
---

<footer class="bg-canvas border-t border-hairline py-16 sm:py-24 transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      
      <!-- Column 1: Services -->
      <div class="flex flex-col gap-4">
        <span class="caption-mono uppercase tracking-wider text-body font-semibold" data-i18n="footer-col-1-title">Services</span>
        <ul class="flex flex-col gap-2.5">
          <li><a href="#calculator" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-1-link-1">Shipping Calculator</a></li>
          <li><a href="#guides" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-1-link-2">Volumetric Weight</a></li>
          <li><a href="#guides" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-1-link-3">Movers vs Courier</a></li>
          <li><a href="#guides" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-1-link-4">Reduce Shipping Costs</a></li>
        </ul>
      </div>

      <!-- Column 2: Legal -->
      <div class="flex flex-col gap-4">
        <span class="caption-mono uppercase tracking-wider text-body font-semibold" data-i18n="footer-col-2-title">Legal</span>
        <ul class="flex flex-col gap-2.5">
          <li><a href="#privacy" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-2-link-1">Privacy Policy</a></li>
          <li><a href="#terms" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-2-link-2">Terms of Service</a></li>
          <li><a href="#disclaimer" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-2-link-3">Rate Disclaimer</a></li>
          <li><a href="#licensing" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-2-link-4">Licensing</a></li>
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div class="flex flex-col gap-4">
        <span class="caption-mono uppercase tracking-wider text-body font-semibold" data-i18n="footer-col-3-title">Company</span>
        <ul class="flex flex-col gap-2.5">
          <li><a href="#about" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-3-link-1">About Us</a></li>
          <li><a href="#blog" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-3-link-2">Courier Blog</a></li>
          <li><a href="#careers" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-3-link-3">Careers</a></li>
          <li><a href="#press" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-3-link-4">Press Kit</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div class="flex flex-col gap-4">
        <span class="caption-mono uppercase tracking-wider text-body font-semibold" data-i18n="footer-col-4-title">Contact & Help</span>
        <ul class="flex flex-col gap-2.5">
          <li><a href="#support" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-4-link-1">Partner Inquiry</a></li>
          <li><a href="#contact" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-4-link-2">Help Center</a></li>
          <li><a href="mailto:support@courierprice.com" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-4-link-3">Email Support</a></li>
          <li><a href="#feedback" class="text-sm text-mute hover:text-ink transition-colors" data-i18n="footer-col-4-link-4">Submit Feedback</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Line -->
    <div class="mt-16 pt-8 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4 transition-colors duration-200">
      <div class="flex items-center gap-2">
        <svg class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
        <span class="text-xs text-mute font-sans">
          &copy; {new Date().getFullYear()} courierprice.com. <span data-i18n="footer-copyright">All rights reserved.</span>
        </span>
      </div>
      <p class="caption text-mute text-center sm:text-right max-w-md" data-i18n="footer-disclaimer">
        Designed to simplify courier price comparison globally. All trademarked carrier logos and names are properties of their respective owners.
      </p>
    </div>
  </div>
</footer>
