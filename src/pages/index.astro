---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CalculatorForm from '../components/CalculatorForm.astro';
import ResultsList from '../components/ResultsList.astro';
import Educational from '../components/Educational.astro';
import SeoContent from '../components/SeoContent.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Courier Price Calculator - Compare Courier Price & Shipping Rates"
  description="Compare courier prices instantly! Use our free courier price calculator to get a complete courier price list for DTDC courier price, Garudavega courier price list, Professional courier price per kg, Delhivery, Blue Dart, and global delivery courier prices."
>
  <!-- Header Nav -->
  <Header />

  <!-- Main Content Layout -->
  <main class="flex-grow">
    <!-- Hero Section with animated mesh gradient background -->
    <Hero />

    <!-- Application Engine Container -->
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24 space-y-16">
      
      <!-- Anchor for form scroll target -->
      <div id="calculator-anchor" class="scroll-mt-24">
        <CalculatorForm />
      </div>

      <!-- Live Results Area (toggled visible when estimates generate) -->
      <ResultsList />

    </div>

    <!-- Educational Resource Hub -->
    <Educational />

    <!-- SEO Optimized Content Section -->
    <SeoContent />

    <!-- Frequently Asked Questions -->
    <FAQ />
  </main>

  <!-- Footer Nav -->
  <Footer />
</Layout>
