---
// src/pages/international/india-to-uk.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import CalculatorForm from '../../components/CalculatorForm.astro';
import ResultsList from '../../components/ResultsList.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://courierprice.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "International Shipping",
      "item": "https://courierprice.com/international/india-to-uk/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "India to UK",
      "item": "https://courierprice.com/international/india-to-uk/"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does it cost to send a parcel from India to UK?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Shipping a 1 kg parcel from India to the UK typically costs ₹1,600 to ₹3,400 depending on transit speed. India Post EMS is the most economical, while DHL Express and FedEx provide 2–4 day priority air transit."
      }
    },
    {
      "@type": "Question",
      "name": "What is the UK import VAT and customs duty threshold?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Consignments valued up to £135 are subject to 20% UK import VAT. Consignments valued over £135 are subject to both import VAT and applicable UK customs duties."
      }
    },
    {
      "@type": "Question",
      "name": "What items cannot be sent to the UK from India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Meat/dairy products, unsealed homemade foods, counterfeit goods, controlled prescription drugs without doctor certification, and flammables/aerosols are strictly prohibited by UK Border Force."
      }
    }
  ]
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "India to UK Courier Price Calculator & Shipping Guide",
  "url": "https://courierprice.com/international/india-to-uk/",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Calculate international courier charges from India to the United Kingdom. Compare DHL, FedEx, UPS, and India Post EMS rates and UK customs VAT rules."
};
---

<Layout 
  title="Courier Charges from India to UK - Rates Per KG (2026)"
  description="Compare courier charges from India to the UK. Compare DHL, FedEx, UPS & India Post EMS rates, UK import VAT rules (£135 threshold), and delivery times."
>
  <!-- Schema Injections -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />

  <Header />

  <main class="w-full">
    <!-- Breadcrumb Section -->
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-2">
      <nav class="flex items-center gap-2 text-xs text-mute" aria-label="Breadcrumb">
        <a href="/" class="hover:text-ink transition-colors">Home</a>
        <span>/</span>
        <span class="text-mute">International</span>
        <span>/</span>
        <span class="text-ink font-medium" aria-current="page">India to UK</span>
      </nav>
    </div>

    <!-- Hero Section -->
    <section class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-hairline bg-canvas-soft text-xs text-mute font-medium">
          <span class="inline-block w-2 h-2 rounded-full bg-blue-500"></span>
          <span>International Shipping Corridor</span>
        </div>
        <h1 class="display-lg text-ink font-semibold tracking-tight">
          Courier Charges from India to UK (2026).
        </h1>
        <p class="body-lg text-body leading-relaxed">
          Estimate international parcel shipping rates from India to London, Manchester, Birmingham, and across the United Kingdom. Compare DHL, FedEx, UPS, and India Post EMS tariffs with UK VAT rules.
        </p>
      </div>
    </section>

    <!-- Calculator Section -->
    <section class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pb-12 sm:pb-16 space-y-8">
      <CalculatorForm />
      <ResultsList />
    </section>

    <!-- Educational Guide -->
    <article class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-hairline space-y-12">
      
      <!-- Section 1: Rate Matrix -->
      <section class="space-y-6">
        <h2 class="display-md text-ink font-semibold">Indicative Shipping Rates: India to UK.</h2>
        <div class="overflow-x-auto border border-hairline rounded-lg bg-canvas shadow-level-2">
          <table class="w-full text-left border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="border-b border-hairline bg-canvas-soft text-ink font-semibold">
                <th class="py-3 px-4">Weight Slab</th>
                <th class="py-3 px-4">India Post EMS</th>
                <th class="py-3 px-4">FedEx Economy</th>
                <th class="py-3 px-4">DHL Express</th>
                <th class="py-3 px-4">Estimated Transit</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline text-body font-mono">
              <tr class="hover:bg-canvas-soft-2 transition-colors">
                <td class="py-2.5 px-4 font-semibold text-ink font-sans">0.5 kg (Documents)</td>
                <td class="py-2.5 px-4">₹1,000 – ₹1,400</td>
                <td class="py-2.5 px-4">₹1,900 – ₹2,600</td>
                <td class="py-2.5 px-4">₹2,600 – ₹3,400</td>
                <td class="py-2.5 px-4 font-sans text-xs">2 – 7 Days</td>
              </tr>
              <tr class="hover:bg-canvas-soft-2 transition-colors">
                <td class="py-2.5 px-4 font-semibold text-ink font-sans">1.0 kg</td>
                <td class="py-2.5 px-4">₹1,500 – ₹2,100</td>
                <td class="py-2.5 px-4">₹2,500 – ₹3,400</td>
                <td class="py-2.5 px-4">₹3,400 – ₹4,400</td>
                <td class="py-2.5 px-4 font-sans text-xs">2 – 7 Days</td>
              </tr>
              <tr class="hover:bg-canvas-soft-2 transition-colors">
                <td class="py-2.5 px-4 font-semibold text-ink font-sans">2.0 kg</td>
                <td class="py-2.5 px-4">₹2,400 – ₹3,200</td>
                <td class="py-2.5 px-4">₹3,800 – ₹4,900</td>
                <td class="py-2.5 px-4">₹4,900 – ₹6,300</td>
                <td class="py-2.5 px-4 font-sans text-xs">2 – 6 Days</td>
              </tr>
              <tr class="hover:bg-canvas-soft-2 transition-colors">
                <td class="py-2.5 px-4 font-semibold text-ink font-sans">5.0 kg</td>
                <td class="py-2.5 px-4">₹4,800 – ₹6,300</td>
                <td class="py-2.5 px-4">₹6,900 – ₹8,900</td>
                <td class="py-2.5 px-4">₹8,900 – ₹11,500</td>
                <td class="py-2.5 px-4 font-sans text-xs">2 – 5 Days</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 2: UK Customs & VAT -->
      <section class="pt-8 border-t border-hairline space-y-6">
        <h2 class="display-md text-ink font-semibold">UK Customs, Taxes & Prohibited Goods.</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-2">
          <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-level-1 space-y-2">
            <h3 class="body-md-strong text-ink font-semibold">1. £135 VAT Threshold</h3>
            <p class="body-sm text-body">Parcels entering the UK are charged 20% standard import VAT. Goods above £135 value also incur UK customs duty.</p>
          </div>
          <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-level-1 space-y-2">
            <h3 class="body-md-strong text-ink font-semibold">2. Gift Exemptions</h3>
            <p class="body-sm text-body">Gifts sent between private individuals valued under £39 qualify for statutory import VAT and customs duty relief.</p>
          </div>
          <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-level-1 space-y-2">
            <h3 class="body-md-strong text-ink font-semibold">3. Food & Plant Restrictions</h3>
            <p class="body-sm text-body">Dairy, meat, and fresh fruits/vegetables are strictly prohibited from entry into the UK without phytosanitary certificates.</p>
          </div>
        </div>
      </section>

      <!-- Section 3: FAQs -->
      <section class="pt-8 border-t border-hairline space-y-6">
        <h2 class="display-md text-ink font-semibold">Frequently Asked Questions.</h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map(faq => (
            <div class="border border-hairline rounded-lg p-5 bg-canvas shadow-level-1 space-y-2">
              <h3 class="body-md-strong text-ink font-semibold">{faq.name}</h3>
              <p class="body-sm text-body leading-relaxed">{faq.acceptedAnswer.text}</p>
            </div>
          ))}
        </div>
      </section>

    </article>
  </main>

  <Footer />
</Layout>

<script>
  // Automatically pre-fill the form with India -> UK international route
  window.addEventListener('DOMContentLoaded', () => {
    const tabIntl = document.getElementById('tab-international');
    if (tabIntl) tabIntl.click();

    setTimeout(() => {
      const pickupCountry = document.getElementById('pickupCountry') as HTMLSelectElement | null;
      const deliveryCountry = document.getElementById('deliveryCountry') as HTMLSelectElement | null;
      
      if (pickupCountry) {
        pickupCountry.value = 'IN';
        pickupCountry.dispatchEvent(new Event('change'));
      }
      if (deliveryCountry) {
        deliveryCountry.value = 'GB';
        deliveryCountry.dispatchEvent(new Event('change'));
      }
    }, 100);
  });
</script>
