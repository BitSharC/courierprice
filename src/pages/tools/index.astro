---
// src/pages/tools/index.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://courierprice.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Tools",
      "item": "https://courierprice.com/tools/"
    }
  ]
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Shipping & Logistics Calculation Tools Directory",
  "url": "https://courierprice.com/tools/",
  "description": "Free logistics utilities: volumetric weight calculator, CBM cubic meter estimator, and courier rate calculators."
};
---

<Layout
  title="Shipping & Logistics Tools Directory | CourierPrice"
  description="Free logistics tools including Volumetric Weight Calculator, CBM volume calculator, and courier comparison tools."
>
  <!-- Schema Injections -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <Header />

  <main class="w-full">
    <!-- Breadcrumb Section -->
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-2">
      <nav class="flex items-center gap-2 text-xs text-mute" aria-label="Breadcrumb">
        <a href="/" class="hover:text-ink transition-colors">Home</a>
        <span>/</span>
        <span class="text-ink font-medium" aria-current="page">Logistics Tools</span>
      </nav>
    </div>

    <!-- Hero Section -->
    <section class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-hairline bg-canvas-soft text-xs text-mute font-medium">
          <span class="inline-block w-2 h-2 rounded-full bg-primary"></span>
          <span>Free Online Utilities</span>
        </div>
        <h1 class="display-lg text-ink font-semibold tracking-tight">
          Shipping & Logistics Tools.
        </h1>
        <p class="body-lg text-body leading-relaxed">
          Free calculation utilities to optimize parcel packaging, compute volumetric dimensions, calculate CBM freight volumes, and compare courier rates.
        </p>
      </div>
    </section>

    <!-- Tools Cards Grid -->
    <section class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Volumetric Calculator Card -->
        <a 
          href="/tools/volumetric-weight-calculator" 
          class="group bg-canvas border border-hairline hover:border-hairline-strong rounded-lg p-6 shadow-level-2 hover:shadow-level-3 transition-all flex flex-col justify-between space-y-4 cursor-pointer"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-mute uppercase">Dimensional Weight</span>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-primary/10 text-primary font-semibold">CBM & DIM</span>
            </div>
            <h2 class="display-sm text-xl text-ink font-semibold group-hover:text-primary transition-colors">
              Volumetric Weight Calculator ➔
            </h2>
            <p class="body-sm text-body leading-relaxed text-xs">
              Compute dimensional weight in kg/lbs, CBM volume, and compare courier divisors (5000 vs 6000 vs 4000).
            </p>
          </div>
          <div class="flex items-center text-xs font-semibold text-primary pt-2 border-t border-hairline">
            <span>Open Tool</span>
            <span class="ml-1 group-hover:translate-x-1 transition-transform">➔</span>
          </div>
        </a>

        <!-- Shipping Rate Comparison Tool Card -->
        <a 
          href="/#calculator-anchor" 
          class="group bg-canvas border border-hairline hover:border-hairline-strong rounded-lg p-6 shadow-level-2 hover:shadow-level-3 transition-all flex flex-col justify-between space-y-4 cursor-pointer"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-mute uppercase">Price Estimation</span>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-canvas-soft text-mute">15+ Couriers</span>
            </div>
            <h2 class="display-sm text-xl text-ink font-semibold group-hover:text-primary transition-colors">
              Multi-Courier Shipping Calculator ➔
            </h2>
            <p class="body-sm text-body leading-relaxed text-xs">
              Compare domestic and international courier prices, estimated delivery days, and reliability ratings in one place.
            </p>
          </div>
          <div class="flex items-center text-xs font-semibold text-primary pt-2 border-t border-hairline">
            <span>Open Calculator</span>
            <span class="ml-1 group-hover:translate-x-1 transition-transform">➔</span>
          </div>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
