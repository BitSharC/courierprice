---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Courier Price Comparison - Compare shipping rates across India",
  description = "Compare shipping estimates and courier delivery prices from India Post, Blue Dart, DTDC, Delhivery, Garudavega, Porter & more in under 30 seconds."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="CourierPrice" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="courier price, dtdc courier price, garudavega courier price list, professional courier price per kg, dtdc courier price per kg, dtdc courier price calculator, courier price calculator, professional courier price list, courier price per kg, blue dart courier price, courier price list, dtdc courier price list, professional courier price calculator, delhivery courier price, professional courier price, delivery courier price, usa to india courier price, india to usa courier price, india to uk courier price, courier price comparison, shipping rates India" />
    <link rel="canonical" href="https://courierprice.com/" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://courierprice.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://courierprice.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="CourierPrice" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://courierprice.com/" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://courierprice.com/og-image.png" />

    <!-- Google Fonts Preconnect and Import -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet" />

    <!-- Inline script to determine theme early to prevent flashes -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const theme = getTheme();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-G6Q6MVBJRG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-G6Q6MVBJRG');
    </script>
  </head>
  <body class="bg-canvas-soft text-ink min-h-screen flex flex-col antialiased">
    <slot />

    <!-- Client-side translations script -->
    <script>
      import { TRANSLATIONS } from '../utils/translations';

      function applyTranslations(lang: string) {
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (key && TRANSLATIONS[lang] && TRANSLATIONS[lang][key]) {
            const text = TRANSLATIONS[lang][key];
            if (text.includes('<') && text.includes('>')) {
              el.innerHTML = text;
            } else {
              el.textContent = text;
            }
          }
        });

        // Translate placeholders
        document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (key && TRANSLATIONS[lang] && TRANSLATIONS[lang][key]) {
            el.setAttribute('placeholder', TRANSLATIONS[lang][key]);
          }
        });

        // Set document attributes
        document.documentElement.lang = lang;
        if (lang === 'ar') {
          document.documentElement.dir = 'rtl';
          document.documentElement.classList.add('rtl');
        } else {
          document.documentElement.dir = 'ltr';
          document.documentElement.classList.remove('rtl');
        }
      }

      // Initial translation setup on load
      const savedLang = localStorage.getItem('lang') || 'en';
      applyTranslations(savedLang);

      // Expose globally for components to access
      (window as any).applyLanguage = (lang: string) => {
        localStorage.setItem('lang', lang);
        applyTranslations(lang);
        window.dispatchEvent(new CustomEvent('language-change', { detail: lang }));
      };
    </script>
  </body>
</html>
